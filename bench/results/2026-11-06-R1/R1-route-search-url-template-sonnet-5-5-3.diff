diff --git a/backend/src/validation/fields.ts b/backend/src/validation/fields.ts
index ef92b4c..16a9675 100644
--- a/backend/src/validation/fields.ts
+++ b/backend/src/validation/fields.ts
@@ -5,6 +5,9 @@ export const MAX_TEXT = 100;
 /** 片道運賃の上限（円）。桁の打ち間違いを防ぐための目安 */
 export const MAX_FARE = 100_000;
 
+/** URL の長さの上限。経路結果の URL は長くなりがちなので、文字の項目より大きくしている */
+export const MAX_URL = 2000;
+
 /** JSON のオブジェクト（配列と null を除く）かどうか */
 export function isRecord(value: unknown): value is Record<string, unknown> {
   return typeof value === "object" && value !== null && !Array.isArray(value);
@@ -88,3 +91,45 @@ export function fare(
   }
   return value;
 }
+
+/**
+ * 任意の URL。無い・空なら undefined。http:// か https:// で始まるものだけ通す。
+ * 画面に出してリンクにするので、javascript: など別の種類の URL は受け付けない。
+ */
+export function optionalUrl(
+  body: Record<string, unknown>,
+  field: string,
+  label: string,
+  errors: FieldError[],
+): string | undefined {
+  const value = body[field];
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  if (typeof value !== "string") {
+    errors.push({ field, message: `${label}は文字で入力してください` });
+    return undefined;
+  }
+  const trimmed = value.trim();
+  if (trimmed === "") {
+    return undefined;
+  }
+  if (trimmed.length > MAX_URL) {
+    errors.push({ field, message: `${label}は${MAX_URL}文字以内で入力してください` });
+    return undefined;
+  }
+  if (!isHttpUrl(trimmed)) {
+    errors.push({ field, message: `${label}は http:// か https:// で始まる URL を入力してください` });
+    return undefined;
+  }
+  return trimmed;
+}
+
+function isHttpUrl(value: string): boolean {
+  try {
+    const url = new URL(value);
+    return (url.protocol === "http:" || url.protocol === "https:") && url.hostname !== "";
+  } catch {
+    return false;
+  }
+}
