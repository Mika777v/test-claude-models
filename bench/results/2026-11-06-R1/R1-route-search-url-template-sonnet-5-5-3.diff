     expect(fields({})).toEqual(["name", "from", "to", "transport", "oneWayFare"]);
   });
+
+  describe("searchUrl（経路の URL）", () => {
+    const url = "https://roote.ekispert.net/result?arr=B&dep=A";
+
+    it("無い・null・空白だけなら、項目なしで ok", () => {
