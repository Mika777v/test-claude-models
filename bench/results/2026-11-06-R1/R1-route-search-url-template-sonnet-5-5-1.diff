diff --git a/backend/src/validation/fields.ts b/backend/src/validation/fields.ts
index ef92b4c..0e70bc9 100644
--- a/backend/src/validation/fields.ts
+++ b/backend/src/validation/fields.ts
@@ -2,6 +2,8 @@ import { TRANSPORTS, type FieldError, type Transport } from "@routepense/shared"
 
 /** 文字の項目の長さの上限 */
 export const MAX_TEXT = 100;
+/** URL の長さの上限。経路結果の URL は長くなりがちなので、文字の項目より大きくする */
+export const MAX_URL = 2000;
 /** 片道運賃の上限（円）。桁の打ち間違いを防ぐための目安 */
 export const MAX_FARE = 100_000;
 
@@ -88,3 +90,43 @@ export function fare(
   }
   return value;
 }
+
+/** 任意の URL（http:// か https:// で始まるもの）。無い・空なら undefined。前後の空白は取り除く */
+export function optionalUrl(
+  body: Record<string, unknown>,
+  field: string,
+  label: string,
+  errors: FieldError[],
+): string | undefined {
+  const value = body[field];
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  if (typeof value !== "string") {
+    errors.push({ field, message: `${label}は文字で入力してください` });
+    return undefined;
+  }
+  const trimmed = value.trim();
+  if (trimmed === "") {
+    return undefined;
+  }
+  if (trimmed.length > MAX_URL) {
+    errors.push({ field, message: `${label}は${MAX_URL}文字以内で入力してください` });
+  } else if (!isHttpUrl(trimmed)) {
+    errors.push({ field, message: `${label}は http:// か https:// で始まる URL を入力してください` });
+  }
+  return trimmed;
+}
+
+/** http(s) の URL として読めるか。javascript: などの別の種類は通さない */
+function isHttpUrl(value: string): boolean {
+  if (!/^https?:\/\//i.test(value)) {
+    return false;
+  }
+  try {
+    new URL(value);
+    return true;
+  } catch {
+    return false;
+  }
+}
