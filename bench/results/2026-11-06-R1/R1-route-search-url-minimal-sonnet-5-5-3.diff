diff --git a/backend/src/validation/fields.ts b/backend/src/validation/fields.ts
index ef92b4c..f3c0450 100644
--- a/backend/src/validation/fields.ts
+++ b/backend/src/validation/fields.ts
@@ -88,3 +88,39 @@ export function fare(
   }
   return value;
 }
+
+/** URL の長さの上限。ブラウザや多くのサーバーが扱える長さの目安 */
+export const MAX_URL = 2000;
+
+/** 任意の URL。無い・空なら undefined。http:// か https:// で始まり、空白を含まないこと */
+export function optionalUrl(
+  body: Record<string, unknown>,
+  field: string,
+  label: string,
+  errors: FieldError[],
+): string | undefined {
+  const value = body[field];
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  if (typeof value !== "string") {
+    errors.push({ field, message: `${label}は文字で入力してください` });
+    return undefined;
+  }
+  const trimmed = value.trim();
+  if (trimmed === "") {
+    return undefined;
+  }
+  if (trimmed.length > MAX_URL) {
+    errors.push({
+      field,
+      message: `${label}は${MAX_URL}文字以内で入力してください`,
+    });
+  } else if (!/^https?:\/\/[^\s]+$/i.test(trimmed)) {
+    errors.push({
+      field,
+      message: `${label}は http:// か https:// で始まる URL を入力してください`,
+    });
+  }
+  return trimmed;
+}
