+/** URL の長さの上限。経路結果の URL は長くなりやすいので、文字の項目より大きくする */
+export const MAX_URL = 2000;
+
+/** 任意の URL（http:// か https:// で始まるもの）。無い・空なら undefined */
+export function optionalUrl(
+  body: Record<string, unknown>,
+  field: string,
+  label: string,
+  errors: FieldError[],
+): string | undefined {
+  const value = body[field];
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  if (typeof value !== "string") {
+    errors.push({ field, message: `${label}は文字で入力してください` });
+    return undefined;
+  }
+  const trimmed = value.trim();
+  if (trimmed === "") {
+    return undefined;
+  }
+  if (trimmed.length > MAX_URL) {
+    errors.push({ field, message: `${label}は${MAX_URL}文字以内で入力してください` });
+    return undefined;
+  }
+  if (!isHttpUrl(trimmed)) {
+    errors.push({ field, message: `${label}は http:// または https:// で始まる URL を入力してください` });
+    return undefined;
+  }
+  return trimmed;
+}
+
+function isHttpUrl(value: string): boolean {
+  if (!/^https?:\/\//i.test(value)) return false;
+  try {
+    new URL(value);
+    return true;
+  } catch {
+    return false;
+  }
+}
