diff --git a/backend/src/validation/fields.ts b/backend/src/validation/fields.ts
index ef92b4c..71c0a21 100644
--- a/backend/src/validation/fields.ts
+++ b/backend/src/validation/fields.ts
@@ -2,6 +2,8 @@ import { TRANSPORTS, type FieldError, type Transport } from "@routepense/shared"
 
 /** 文字の項目の長さの上限 */
 export const MAX_TEXT = 100;
+/** 経路結果の URL の長さの上限 */
+export const MAX_URL = 2000;
 /** 片道運賃の上限（円）。桁の打ち間違いを防ぐための目安 */
 export const MAX_FARE = 100_000;
 
@@ -81,10 +83,38 @@ export function fare(
     return undefined;
   }
   if (value > MAX_FARE) {
-    errors.push({
-      field,
-      message: `片道運賃は${MAX_FARE.toLocaleString("ja-JP")}円以下で入力してください`,
-    });
+    errors.push({ field, message: `片道運賃は${MAX_FARE.toLocaleString("ja-JP")}円以下で入力してください` });
   }
   return value;
 }
+
+/** 任意の http(s) の URL。無い・空なら undefined。前後の空白は取り除く */
+export function optionalHttpUrl(
+  body: Record<string, unknown>,
+  field: string,
+  label: string,
+  errors: FieldError[],
+): string | undefined {
+  const value = body[field];
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  if (typeof value !== "string") {
+    errors.push({ field, message: `${label}は文字で入力してください` });
+    return undefined;
+  }
+  const trimmed = value.trim();
+  if (trimmed === "") {
+    return undefined;
+  }
+  if (trimmed.length > MAX_URL) {
+    errors.push({ field, message: `${label}は${MAX_URL}文字以内で入力してください` });
+    return undefined;
+  }
+  // javascript: などを防ぐため、http(s) で始まり、URL として読めるものだけ通す
+  if (!/^https?:\/\//i.test(trimmed) || !URL.canParse(trimmed)) {
+    errors.push({ field, message: `${label}は http:// か https:// で始まる URL を入力してください` });
+    return undefined;
+  }
+  return trimmed;
+}
