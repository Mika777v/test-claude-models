   create(userId: string, input: RouteInput): Route;
   /** 見つからなければ undefined */
   update(userId: string, id: string, input: RouteInput): Route | undefined;
+  /** 片付ける（archived: true）・使うように戻す（false）。見つからなければ undefined */
+  setArchived(userId: string, id: string, archived: boolean): Route | undefined;
   /** 消せたら true、見つからなければ false */
   delete(userId: string, id: string): boolean;
 }
