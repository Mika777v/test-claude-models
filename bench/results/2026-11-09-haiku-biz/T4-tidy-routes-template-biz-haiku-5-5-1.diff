+import { describe, expect, it } from "vitest";
+import type { RouteInput } from "@routepense/shared";
+import { openDatabase } from "../db/database";
+import { SqliteRouteRepository } from "../routes/sqlite-route-repository";
+import { resolveWorkStyle } from "./resolve-work-style";
+
+const input: RouteInput = { name: "自宅↔本社", from: "A駅", to: "B駅", transport: "train", oneWayFare: 220 };
+
+describe("resolveWorkStyle", () => {
+  it("使っているルートなら、ルートの値をコピーした出勤になる", () => {
+    const db = openDatabase(":memory:");
+    const routes = new SqliteRouteRepository(db);
+    const route = routes.create("user-1", input);
+
+    expect(resolveWorkStyle({ kind: "commute", routeId: route.id }, routes, "user-1")).toEqual({
+      kind: "commute",
+      routeId: route.id,
+      route: input,
+    });
+    db.close();
+  });
+
+  it("片付けたルートは、新しい記録には使えない（undefined）", () => {
+    const db = openDatabase(":memory:");
+    const routes = new SqliteRouteRepository(db);
+    const route = routes.create("user-1", input);
+    routes.setArchived("user-1", route.id, true);
+
+    expect(resolveWorkStyle({ kind: "commute", routeId: route.id }, routes, "user-1")).toBeUndefined();
+    db.close();
+  });
+});
