+
+const archivedMessage = "true か false で指定してください";
+
+/** 一覧の ?archived= の値。無ければ false（使っているルート）。"true" か "false" 以外は誤り */
+export function parseArchivedQuery(value: unknown): Result<boolean> {
+  if (value === undefined || value === "false") {
+    return { ok: true, value: false };
+  }
+  if (value === "true") {
+    return { ok: true, value: true };
+  }
+  return { ok: false, errors: [{ field: "archived", message: archivedMessage }] };
+}
+
+/** アーカイブの切り替えの本文 { archived: boolean }。boolean 以外は誤り */
+export function parseArchivedInput(body: unknown): Result<boolean> {
+  if (isRecord(body) && typeof body.archived === "boolean") {
+    return { ok: true, value: body.archived };
+  }
+  return { ok: false, errors: [{ field: "archived", message: archivedMessage }] };
+}
