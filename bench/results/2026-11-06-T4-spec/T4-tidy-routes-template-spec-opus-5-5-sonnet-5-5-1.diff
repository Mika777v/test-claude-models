+import type { Route, WorkStyle } from "@routepense/shared";
+import { describe, expect, it } from "vitest";
+import { buildOptions } from "./day-options";
+
+const base = { userId: "u", from: "A", to: "B", transport: "train", oneWayFare: 100 } as const;
+const active: Route = { ...base, id: "r1", name: "本社" };
+const archived: Route = { ...base, id: "r2", name: "旧支社", archivedAt: "2026-11-01T00:00:00.000Z" };
+const commute = (route: Route): WorkStyle => ({
+  kind: "commute",
+  routeId: route.id,
+  route: { name: route.name, from: route.from, to: route.to, transport: route.transport, oneWayFare: route.oneWayFare },
+});
+const labels = (current: WorkStyle | undefined, routes: Route[]) => buildOptions(current, routes).map((o) => o.label);
+
+describe("buildOptions", () => {
+  it("使わないルートは並べない", () => {
+    expect(labels(undefined, [active, archived])).toEqual(["在宅", "出勤（本社）", "休日"]);
+  });
+
+  it("今の選択が使わないルートなら、今の選択として出す（名前は記録のコピー）", () => {
+    expect(labels(commute(archived), [active, archived])).toEqual(["在宅", "出勤（本社）", "出勤（旧支社）", "休日"]);
+  });
+
+  it("今の選択が使うルートなら、二重に出さない", () => {
+    expect(labels(commute(active), [active, archived])).toEqual(["在宅", "出勤（本社）", "休日"]);
+  });
+
+  it("一覧に無い（削除された）ルートも、今の選択として出す", () => {
+    expect(labels(commute(archived), [active])).toEqual(["在宅", "出勤（本社）", "出勤（旧支社）", "休日"]);
+  });
+
+  it("今の選択が在宅なら、使わないルートは出ない", () => {
+    expect(labels({ kind: "remote" }, [archived])).toEqual(["在宅", "休日"]);
+  });
+});
