+import { activeRoutes, type Route, type WorkStyle } from "@routepense/shared";
+import type { DayChoice } from "./day-edit";
+
+/** 選べるもの1つ分（ボタンに出す名前と、選んだときの値） */
+export type Option = { key: string; label: string; choice: DayChoice };
+
+/**
+ * 今の選択とルートの一覧から、日の編集パネルに並べるボタンを作る。
+ * 使わないルートは並べない。ただし今の選択（記録または当てはめ中の内容）がそのルートなら、今の選択として出す。
+ * 一覧に無い（削除された）ルートも同じで、名前は記録のコピーを使う。
+ */
+export function buildOptions(current: WorkStyle | undefined, routes: readonly Route[]): Option[] {
+  const options: Option[] = [{ key: "remote", label: "在宅", choice: { kind: "remote" } }];
+  for (const route of activeRoutes(routes)) {
+    options.push({
+      key: `commute-${route.id}`,
+      label: `出勤（${route.name}）`,
+      choice: { kind: "commute", routeId: route.id },
+    });
+  }
+  if (current?.kind === "commute" && !options.some((o) => o.key === `commute-${current.routeId}`)) {
+    options.push({
+      key: `commute-${current.routeId}`,
+      label: `出勤（${current.route.name}）`,
+      choice: { kind: "commute", routeId: current.routeId },
+    });
+  }
+  options.push({ key: "holiday", label: "休日", choice: { kind: "holiday" } });
+  return options;
+}
