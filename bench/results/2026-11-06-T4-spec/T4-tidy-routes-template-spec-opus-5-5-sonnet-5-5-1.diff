@@ -0,0 +1,21 @@
+import { describe, expect, it } from "vitest";
+import { activeRoutes, archivedRoutes, type Route } from "./route";
+
+const base = { userId: "u", from: "A", to: "B", transport: "train", oneWayFare: 100 } as const;
+const a: Route = { ...base, id: "a", name: "A" };
+const b: Route = { ...base, id: "b", name: "B", archivedAt: "2026-11-01T00:00:00.000Z" };
+const c: Route = { ...base, id: "c", name: "C" };
+const d: Route = { ...base, id: "d", name: "D", archivedAt: "2026-11-02T00:00:00.000Z" };
+
+describe("activeRoutes / archivedRoutes", () => {
+  it("使う・使わないに分け、元の順を保つ", () => {
+    const all = [a, b, c, d];
+    expect(activeRoutes(all).map((r) => r.id)).toEqual(["a", "c"]);
+    expect(archivedRoutes(all).map((r) => r.id)).toEqual(["b", "d"]);
+  });
+
+  it("空なら空", () => {
+    expect(activeRoutes([])).toEqual([]);
+    expect(archivedRoutes([])).toEqual([]);
+  });
+});
