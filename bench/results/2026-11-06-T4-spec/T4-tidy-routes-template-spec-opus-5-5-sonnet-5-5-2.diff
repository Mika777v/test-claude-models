+import { describe, expect, it } from "vitest";
+import { activeRoutes } from "./route";
+
+describe("activeRoutes", () => {
+  it("使わないルートを外し、残りの順番は変えない", () => {
+    const routes = [
+      { id: "a", archived: false },
+      { id: "b", archived: true },
+      { id: "c", archived: false },
+    ];
+    expect(activeRoutes(routes).map((r) => r.id)).toEqual(["a", "c"]);
+  });
+
+  it("全部使わないなら空、元の配列は変えない", () => {
+    const routes = [{ archived: true }];
+    expect(activeRoutes(routes)).toEqual([]);
+    expect(routes).toHaveLength(1);
+  });
+});
