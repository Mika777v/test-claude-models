+
+/** PUT /api/routes/:id/archived の本文（{ "archived": true | false }）を確かめる */
+export function parseRouteArchivedInput(body: unknown): Result<RouteArchivedInput> {
+  if (!isRecord(body)) {
+    return { ok: false, errors: [{ field: "", message: "JSON のオブジェクトを送ってください" }] };
+  }
+  if (typeof body.archived !== "boolean") {
+    return { ok: false, errors: [{ field: "archived", message: "archived は true か false で指定してください" }] };
+  }
+  return { ok: true, value: { archived: body.archived } };
+}
