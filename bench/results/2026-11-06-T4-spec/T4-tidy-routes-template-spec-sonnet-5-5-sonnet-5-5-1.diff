@@ -0,0 +1,27 @@
+import { isRecord } from "../validation/fields";
+import type { Result } from "../validation/result";
+
+/** PATCH /api/routes/:id の本文 { archived: boolean } を確かめる */
+export function parseArchiveInput(body: unknown): Result<{ archived: boolean }> {
+  if (!isRecord(body) || typeof body.archived !== "boolean") {
+    return {
+      ok: false,
+      errors: [{ field: "archived", message: "archived は true か false で指定してください" }],
+    };
+  }
+  return { ok: true, value: { archived: body.archived } };
+}
+
+/** GET /api/routes の ?includeArchived を確かめる。無ければ false */
+export function parseIncludeArchived(query: unknown): Result<boolean> {
+  if (query === undefined) {
+    return { ok: true, value: false };
+  }
+  if (query === "true" || query === "false") {
+    return { ok: true, value: query === "true" };
+  }
+  return {
+    ok: false,
+    errors: [{ field: "includeArchived", message: "includeArchived は true か false で指定してください" }],
+  };
+}
