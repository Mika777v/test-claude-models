@@ -0,0 +1,44 @@
+import type { RouteInput } from "@routepense/shared";
+import { beforeEach, describe, expect, it } from "vitest";
+import { openDatabase } from "../db/database";
+import { SqliteRouteRepository } from "../routes/sqlite-route-repository";
+import { resolveWorkStyle } from "./resolve-work-style";
+
+const input: RouteInput = { name: "自宅↔本社", from: "A駅", to: "B駅", transport: "train", oneWayFare: 220 };
+
+describe("resolveWorkStyle", () => {
+  let repo: SqliteRouteRepository;
+
+  beforeEach(() => {
+    repo = new SqliteRouteRepository(openDatabase(":memory:"));
+  });
+
+  it("在宅と休日はそのまま通す", () => {
+    expect(resolveWorkStyle({ kind: "remote" }, repo, "u")).toEqual({ ok: true, workStyle: { kind: "remote" } });
+  });
+
+  it("使うルートの出勤は、ルートの値をコピーして返す", () => {
+    const route = repo.create("u", input);
+    expect(resolveWorkStyle({ kind: "commute", routeId: route.id }, repo, "u")).toEqual({
+      ok: true,
+      workStyle: {
+        kind: "commute",
+        routeId: route.id,
+        route: { name: "自宅↔本社", from: "A駅", to: "B駅", transport: "train", oneWayFare: 220 },
+      },
+    });
+  });
+
+  it("見つからないルートと、使わなくなったルートは理由が違う", () => {
+    const route = repo.create("u", input);
+    repo.setArchived("u", route.id, true);
+    expect(resolveWorkStyle({ kind: "commute", routeId: route.id }, repo, "u")).toEqual({
+      ok: false,
+      reason: "routeArchived",
+    });
+    expect(resolveWorkStyle({ kind: "commute", routeId: "missing" }, repo, "u")).toEqual({
+      ok: false,
+      reason: "routeNotFound",
+    });
+  });
+});
