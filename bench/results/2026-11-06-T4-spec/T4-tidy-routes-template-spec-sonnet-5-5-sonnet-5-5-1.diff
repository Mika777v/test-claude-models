+import type { Route } from "@routepense/shared";
+
+/** ルート管理画面の一覧を、使うルートと使わなくなったルートに分ける（順番は元のまま） */
+export function splitByArchived(routes: Route[]): { active: Route[]; archived: Route[] } {
+  return {
+    active: routes.filter((r) => !r.archived),
+    archived: routes.filter((r) => r.archived),
+  };
+}
