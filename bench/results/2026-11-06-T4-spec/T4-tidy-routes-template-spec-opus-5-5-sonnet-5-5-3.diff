+import { describe, expect, it } from "vitest";
+import { activeRoutes, archivedRoutes, type Route } from "./route";
+
+function route(id: string, archivedAt?: string): Route {
+  return {
+    id,
+    userId: "u1",
+    name: id,
+    from: "A",
+    to: "B",
+    transport: "train",
+    oneWayFare: 100,
+    ...(archivedAt !== undefined && { archivedAt }),
+  };
+}
+
+describe("activeRoutes", () => {
+  it("しまっていないルートだけを、元の並びのまま返す", () => {
+    const routes = [route("a"), route("b", "2026-11-01T00:00:00.000Z"), route("c")];
+    expect(activeRoutes(routes).map((r) => r.id)).toEqual(["a", "c"]);
+  });
+
+  it("全部しまってあれば空、空なら空", () => {
+    expect(activeRoutes([route("a", "2026-11-01T00:00:00.000Z")])).toEqual([]);
+    expect(activeRoutes([])).toEqual([]);
+  });
+});
+
+describe("archivedRoutes", () => {
+  it("しまったルートだけを、新しくしまった順に返す", () => {
+    const routes = [
+      route("a", "2026-11-01T00:00:00.000Z"),
+      route("b"),
+      route("c", "2026-11-03T00:00:00.000Z"),
+      route("d", "2026-11-02T00:00:00.000Z"),
+    ];
+    expect(archivedRoutes(routes).map((r) => r.id)).toEqual(["c", "d", "a"]);
+  });
+
+  it("元の配列は並べ替えない", () => {
+    const routes = [route("a", "2026-11-01T00:00:00.000Z"), route("c", "2026-11-03T00:00:00.000Z")];
+    archivedRoutes(routes);
+    expect(routes.map((r) => r.id)).toEqual(["a", "c"]);
+  });
+});
