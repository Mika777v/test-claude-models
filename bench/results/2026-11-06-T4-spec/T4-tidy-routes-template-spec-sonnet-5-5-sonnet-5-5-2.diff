diff --git a/frontend/src/routes/active-routes.test.ts b/frontend/src/routes/active-routes.test.ts
new file mode 100644
index 0000000..68a9e52
--- /dev/null
+++ b/frontend/src/routes/active-routes.test.ts
@@ -0,0 +1,27 @@
+import type { Route } from "@routepense/shared";
+import { describe, expect, it } from "vitest";
+import { activeRoutes, splitRoutes } from "./active-routes";
+
+function route(id: string, archived: boolean): Route {
+  return { id, userId: "u1", name: id, from: "A", to: "B", transport: "train", oneWayFare: 100, archived };
+}
+
+const routes = [route("a", false), route("b", true), route("c", false), route("d", true)];
+
+describe("activeRoutes", () => {
+  it("使わないルートを除き、並びは元のまま", () => {
+    expect(activeRoutes(routes).map((r) => r.id)).toEqual(["a", "c"]);
+  });
+});
+
+describe("splitRoutes", () => {
+  it("使うルートと使わないルートに分ける", () => {
+    const { active, archived } = splitRoutes(routes);
+    expect(active.map((r) => r.id)).toEqual(["a", "c"]);
+    expect(archived.map((r) => r.id)).toEqual(["b", "d"]);
+  });
+
+  it("空なら両方空", () => {
+    expect(splitRoutes([])).toEqual({ active: [], archived: [] });
+  });
+});
diff --git a/frontend/src/routes/active-routes.ts b/frontend/src/routes/active-routes.ts
new file mode 100644
index 0000000..1fbcf1a
--- /dev/null
+++ b/frontend/src/routes/active-routes.ts
@@ -0,0 +1,11 @@
+import type { Route } from "@routepense/shared";
+
+/** 選択肢に出すルート（「使わない」にしていないもの。ADR-0004）。並びは元のまま */
+export function activeRoutes(routes: readonly Route[]): Route[] {
+  return routes.filter((route) => !route.archived);
+}
+
+/** ルート管理画面の一覧を、使うルートと使わないルートに分ける。並びはそれぞれ元のまま */
+export function splitRoutes(routes: readonly Route[]): { active: Route[]; archived: Route[] } {
+  return { active: activeRoutes(routes), archived: routes.filter((route) => route.archived) };
+}
