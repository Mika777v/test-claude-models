new file mode 100644
index 0000000..3af77ab
--- /dev/null
+++ b/frontend/src/routes/route-archive.ts
@@ -0,0 +1,9 @@
+import type { Route } from "@routepense/shared";
+
+/** ルート管理画面の2つの一覧: 使っているルートと、使わないルート（元の並び順は保つ） */
+export function splitByArchived(routes: Route[]): { active: Route[]; archived: Route[] } {
+  return {
+    active: routes.filter((route) => !route.archived),
+    archived: routes.filter((route) => route.archived),
+  };
+}
