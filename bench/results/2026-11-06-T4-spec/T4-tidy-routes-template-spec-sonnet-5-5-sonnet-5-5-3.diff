+import type { Route } from "@routepense/shared";
+import { describe, expect, it } from "vitest";
+import { splitByArchived } from "./route-archive";
+
+function route(id: string, archived: boolean): Route {
+  return { id, userId: "u1", name: id, from: "中野", to: "東京", transport: "train", oneWayFare: 220, archived };
+}
+
+describe("splitByArchived", () => {
+  it("使っているルートと使わないルートに分け、それぞれ元の並び順を保つ", () => {
+    const { active, archived } = splitByArchived([route("a", false), route("b", true), route("c", false), route("d", true)]);
+    expect(active.map((r) => r.id)).toEqual(["a", "c"]);
+    expect(archived.map((r) => r.id)).toEqual(["b", "d"]);
+  });
+
+  it("空なら両方空", () => {
+    expect(splitByArchived([])).toEqual({ active: [], archived: [] });
+  });
+});
