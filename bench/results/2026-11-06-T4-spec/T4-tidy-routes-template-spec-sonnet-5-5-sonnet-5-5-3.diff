index 0000000..50fb5d4
--- /dev/null
+++ b/backend/src/daily-records/resolve-work-style.test.ts
@@ -0,0 +1,51 @@
+import type { RouteInput } from "@routepense/shared";
+import { beforeEach, describe, expect, it } from "vitest";
+import { openDatabase } from "../db/database";
+import { SqliteRouteRepository } from "../routes/sqlite-route-repository";
+import { resolveWorkStyle } from "./resolve-work-style";
+
+const input: RouteInput = { name: "自宅↔本社", from: "A駅", to: "B駅", transport: "train", oneWayFare: 220 };
+
+describe("resolveWorkStyle", () => {
+  let routes: SqliteRouteRepository;
+
+  beforeEach(() => {
+    routes = new SqliteRouteRepository(openDatabase(":memory:"));
+  });
+
+  it("在宅・休日はそのまま通す", () => {
+    expect(resolveWorkStyle({ kind: "remote" }, routes, "u1")).toEqual({ ok: true, value: { kind: "remote" } });
+    expect(resolveWorkStyle({ kind: "holiday" }, routes, "u1")).toEqual({ ok: true, value: { kind: "holiday" } });
+  });
+
+  it("使っているルートなら、その時点の値をコピーする", () => {
+    const route = routes.create("u1", input);
+    expect(resolveWorkStyle({ kind: "commute", routeId: route.id }, routes, "u1")).toEqual({
+      ok: true,
+      value: {
+        kind: "commute",
+        routeId: route.id,
+        route: { name: "自宅↔本社", from: "A駅", to: "B駅", transport: "train", oneWayFare: 220 },
+      },
+    });
+  });
+
+  it("ルートが無ければ notFound", () => {
+    expect(resolveWorkStyle({ kind: "commute", routeId: "missing" }, routes, "u1")).toEqual({
+      ok: false,
+      problem: "notFound",
+    });
+  });
+
+  it("使わないルートは archived で拒否し、戻せば通る", () => {
+    const route = routes.create("u1", input);
+    routes.archive("u1", route.id);
+    expect(resolveWorkStyle({ kind: "commute", routeId: route.id }, routes, "u1")).toEqual({
+      ok: false,
+      problem: "archived",
+    });
+
+    routes.restore("u1", route.id);
+    expect(resolveWorkStyle({ kind: "commute", routeId: route.id }, routes, "u1").ok).toBe(true);
+  });
+});
