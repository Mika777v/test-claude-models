@@ -1,27 +1,36 @@
 import type { WorkStyle, WorkStyleInput } from "@routepense/shared";
 import type { RouteRepository } from "../routes/route-repository";
 
+/** ルートを使えない理由。画面に出すメッセージは routeProblemMessage で決める */
+export type RouteProblem = "notFound" | "archived";
+
+export type ResolveResult = { ok: true; value: WorkStyle } | { ok: false; problem: RouteProblem };
+
+/** routeId のフィールドエラーに出す文 */
+export const routeProblemMessage: Record<RouteProblem, string> = {
+  notFound: "選んだルートが見つかりません",
+  archived: "このルートは使わない設定になっています",
+};
+
 /**
  * 画面から届いた勤務区分を、保存する形に変える。
  * 出勤なら、登録済みのルートの値をその時点でコピーする（後でルートを直しても、記録は変わらない）。
- * ルートが見つからなければ undefined。
+ * ルートが見つからない、または「使わない」設定なら、使えない理由を返す（新しい記録には使わせない）。
  */
-export function resolveWorkStyle(
-  input: WorkStyleInput,
-  routes: RouteRepository,
-  userId: string,
-): WorkStyle | undefined {
+export function resolveWorkStyle(input: WorkStyleInput, routes: RouteRepository, userId: string): ResolveResult {
   if (input.kind !== "commute") {
-    return input;
+    return { ok: true, value: input };
   }
   const route = routes.get(userId, input.routeId);
   if (route === undefined) {
-    return undefined;
+    return { ok: false, problem: "notFound" };
+  }
+  if (route.archived) {
+    return { ok: false, problem: "archived" };
   }
   const { name, from, to, transport, oneWayFare } = route;
   return {
-    kind: "commute",
-    routeId: route.id,
-    route: { name, from, to, transport, oneWayFare },
+    ok: true,
+    value: { kind: "commute", routeId: route.id, route: { name, from, to, transport, oneWayFare } },
   };
 }
