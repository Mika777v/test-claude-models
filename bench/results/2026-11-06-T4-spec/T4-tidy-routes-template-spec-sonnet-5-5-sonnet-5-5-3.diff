index 0000000..4da93f9
--- /dev/null
+++ b/backend/src/db/migrations.test.ts
@@ -0,0 +1,36 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { describe, expect, it } from "vitest";
+import { SqliteRouteRepository } from "../routes/sqlite-route-repository";
+import { openDatabase } from "./database";
+import { migrations } from "./migrations";
+
+describe("migration 4（routes.archived_at）", () => {
+  it("version 3 までの DB を開くと 4 に上がり、今までのルートは全部「使っている」", () => {
+    const dir = mkdtempSync(join(tmpdir(), "routepense-migration-"));
+    try {
+      const file = join(dir, "old.db");
+      // version 3 までの状態の DB を、migrations から手で作る（アプリを開く前の古い DB に見立てる）
+      const old = new DatabaseSync(file);
+      for (const m of migrations.filter((m) => m.version <= 3)) old.exec(m.sql);
+      old.exec("PRAGMA user_version = 3");
+      old
+        .prepare(
+          `INSERT INTO routes (id, user_id, name, from_place, to_place, transport, one_way_fare, created_at, updated_at)
+           VALUES ('r1', 'u1', '自宅↔本社', 'A駅', 'B駅', 'train', 220, '2026-11-01T00:00:00Z', '2026-11-01T00:00:00Z')`,
+        )
+        .run();
+      old.close();
+
+      const db = openDatabase(file);
+      const version = db.prepare("PRAGMA user_version").get() as { user_version: number };
+      expect(version.user_version).toBe(4);
+      expect(new SqliteRouteRepository(db).list("u1")).toMatchObject([{ id: "r1", archived: false }]);
+      db.close();
+    } finally {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  });
+});
