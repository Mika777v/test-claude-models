@@ -0,0 +1,122 @@
+import type { DailyRecord } from "./daily-record";
+import type { Weekday } from "./date";
+import { weekdayOf } from "./date";
+import { assertNever, extraTripFare, workStyleFare } from "./fare";
+import { holidayName } from "./holidays";
+import type { Transport } from "./route";
+import type { WorkStyleKind } from "./work-style";
+
+/** CSV の1行に必要な、日次記録の項目だけ */
+export type CsvRecord = Pick<DailyRecord, "date" | "workStyle" | "extraTrips">;
+
+/** 見出しの行（F7 の列の順） */
+export const CSV_HEADER: readonly string[] = [
+  "日付",
+  "曜日",
+  "祝日",
+  "勤務区分",
+  "種別",
+  "出発地",
+  "到着地",
+  "交通手段",
+  "片道/往復",
+  "片道運賃",
+  "金額",
+  "ルート名",
+  "目的",
+];
+
+/** 文字化けを防ぐため、ファイルの先頭に付ける BOM（U+FEFF）。表計算ソフトが UTF-8 と判断する目印 */
+export const UTF8_BOM = "﻿";
+
+/** 行の区切り。RFC 4180 に合わせて CRLF */
+const CRLF = "\r\n";
+
+// shared は frontend を参照できないので、表示名はここに持つ（frontend の同名の表と同じ文言）
+const WEEKDAY_LABELS: Record<Weekday, string> = { 0: "日", 1: "月", 2: "火", 3: "水", 4: "木", 5: "金", 6: "土" };
+const TRANSPORT_LABELS: Record<Transport, string> = { train: "電車", bus: "バス", other: "その他" };
+const WORK_STYLE_LABELS: Record<WorkStyleKind, string> = { remote: "在宅", commute: "出勤", holiday: "休日" };
+
+/**
+ * 月の日次記録から、CSV の明細の行を作る（エスケープする前の値）。
+ * 1行 = 1つの移動。出勤日の通常ルートで1行、追加の移動1件ごとに1行。
+ * 移動の無い日（在宅・休日で追加なし）は行を作らない。行の順は、渡された記録の順のまま。
+ */
+export function monthCsvRows(records: readonly CsvRecord[]): string[][] {
+  return records.flatMap((record) => {
+    const { date, workStyle } = record;
+    const common = [
+      date,
+      WEEKDAY_LABELS[weekdayOf(date)],
+      holidayName(date) ?? "",
+      workStyleLabel(workStyle.kind),
+    ];
+
+    const rows: string[][] = [];
+    if (workStyle.kind === "commute") {
+      const { route } = workStyle;
+      rows.push([
+        ...common,
+        "通常",
+        route.from,
+        route.to,
+        TRANSPORT_LABELS[route.transport],
+        "往復", // 通常ルートは常に往復
+        String(route.oneWayFare),
+        String(workStyleFare(workStyle)),
+        route.name,
+        "",
+      ]);
+    }
+    for (const trip of record.extraTrips) {
+      rows.push([
+        ...common,
+        "追加",
+        trip.from,
+        trip.to,
+        TRANSPORT_LABELS[trip.transport],
+        tripTypeLabel(trip.tripType),
+        String(trip.oneWayFare),
+        String(extraTripFare(trip)),
+        "", // 追加の移動はルート名を持たない
+        trip.purpose ?? "",
+      ]);
+    }
+    return rows;
+  });
+}
+
+function workStyleLabel(kind: WorkStyleKind): string {
+  return WORK_STYLE_LABELS[kind];
+}
+
+function tripTypeLabel(tripType: "oneWay" | "roundTrip"): string {
+  switch (tripType) {
+    case "oneWay":
+      return "片道";
+    case "roundTrip":
+      return "往復";
+    default:
+      return assertNever(tripType);
+  }
+}
+
+/**
+ * 1つの値をエスケープする（RFC 4180）。
+ * カンマ・改行（CR / LF）・`"` のどれかを含むときだけ `"` で囲み、中の `"` は `""` に重ねる。
+ */
+export function escapeCsvField(value: string): string {
+  if (!/[",\r\n]/.test(value)) return value;
+  return `"${value.replaceAll('"', '""')}"`;
+}
+
+/** CSV のファイルの中身全体: BOM + 見出し + 明細（各行の終わりは CRLF） */
+export function monthCsv(records: readonly CsvRecord[]): string {
+  const lines = [CSV_HEADER, ...monthCsvRows(records)].map((row) => row.map(escapeCsvField).join(","));
+  return UTF8_BOM + lines.join(CRLF) + CRLF;
+}
+
+/** ファイル名。month は YYYY-MM（例: 2026-11 → routepense-2026-11.csv） */
+export function csvFileName(month: string): string {
+  return `routepense-${month}.csv`;
+}
