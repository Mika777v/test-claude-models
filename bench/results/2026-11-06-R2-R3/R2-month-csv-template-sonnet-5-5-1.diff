+import { describe, expect, it } from "vitest";
+import { CSV_HEADER, UTF8_BOM, csvFileName, escapeCsvField, monthCsv, monthCsvRows, type CsvRecord } from "./csv";
+import type { ExtraTrip } from "./extra-trip";
+import { monthlyFare } from "./fare";
+import type { WorkStyle } from "./work-style";
+
+const commute: WorkStyle = {
+  kind: "commute",
+  routeId: "route-1",
+  route: { name: "自宅↔本社", from: "自宅", to: "本社", transport: "train", oneWayFare: 320 },
+};
+
+function trip(overrides: Partial<ExtraTrip> = {}): ExtraTrip {
+  return { id: "t1", from: "本社", to: "客先B", transport: "bus", oneWayFare: 200, tripType: "oneWay", ...overrides };
+}
+
+function record(date: string, workStyle: WorkStyle, extraTrips: ExtraTrip[] = []): CsvRecord {
+  return { date, workStyle, extraTrips };
+}
+
+describe("escapeCsvField", () => {
+  it("特別な文字が無ければそのまま", () => {
+    expect(escapeCsvField("自宅↔本社")).toBe("自宅↔本社");
+    expect(escapeCsvField("")).toBe("");
+  });
+
+  it("カンマを含めば囲む", () => {
+    expect(escapeCsvField("A,B")).toBe('"A,B"');
+  });
+
+  it("改行（LF・CR・CRLF）を含めば囲む", () => {
+    expect(escapeCsvField("a\nb")).toBe('"a\nb"');
+    expect(escapeCsvField("a\rb")).toBe('"a\rb"');
+    expect(escapeCsvField("a\r\nb")).toBe('"a\r\nb"');
+  });
+
+  it('" は "" に重ねて囲む', () => {
+    expect(escapeCsvField('say "hi"')).toBe('"say ""hi"""');
+    expect(escapeCsvField('"')).toBe('""""');
+  });
+});
+
+describe("monthCsvRows", () => {
+  it("出勤日は通常ルートで1行（列は F7 の順）", () => {
+    // 2026-11-04 は水曜
+    expect(monthCsvRows([record("2026-11-04", commute)])).toEqual([
+      ["2026-11-04", "水", "", "出勤", "通常", "自宅", "本社", "電車", "往復", "320", "640", "自宅↔本社", ""],
+    ]);
+    expect(monthCsvRows([record("2026-11-04", commute)])[0]).toHaveLength(CSV_HEADER.length);
+  });
+
+  it("祝日名が入る", () => {
+    const [row] = monthCsvRows([record("2026-11-03", commute)]);
+    expect(row?.[2]).toBe("文化の日");
+  });
+
+  it("追加の移動は1件ごとに1行。片道は運賃のまま、往復は2倍、ルート名は空、目的が入る", () => {
+    const rows = monthCsvRows([
+      record("2026-11-05", { kind: "remote" }, [
+        trip({ purpose: "客先B打合せ" }),
+        trip({ id: "t2", tripType: "roundTrip", oneWayFare: 150 }),
+      ]),
+    ]);
+    expect(rows).toEqual([
+      ["2026-11-05", "木", "", "在宅", "追加", "本社", "客先B", "バス", "片道", "200", "200", "", "客先B打合せ"],
+      ["2026-11-05", "木", "", "在宅", "追加", "本社", "客先B", "バス", "往復", "150", "300", "", ""],
+    ]);
+  });
+
+  it("出勤日に追加の移動があれば、通常 → 追加の順", () => {
+    const rows = monthCsvRows([record("2026-11-04", commute, [trip()])]);
+    expect(rows.map((r) => r[4])).toEqual(["通常", "追加"]);
+  });
+
+  it("移動の無い日（在宅・休日で追加なし）は行を作らない", () => {
+    expect(monthCsvRows([record("2026-11-02", { kind: "remote" }), record("2026-11-07", { kind: "holiday" })])).toEqual([]);
+    expect(monthCsvRows([])).toEqual([]);
+  });
+
+  it("休日でも追加の移動があれば行になる", () => {
+    const rows = monthCsvRows([record("2026-11-07", { kind: "holiday" }, [trip()])]);
+    expect(rows).toHaveLength(1);
+    expect(rows[0]?.[3]).toBe("休日");
+  });
+});
+
+describe("monthCsv", () => {
+  const records = [
+    record("2026-11-02", commute),
+    record("2026-11-03", { kind: "remote" }),
+    record("2026-11-04", commute, [trip({ purpose: 'A,B "社"\n打合せ' }), trip({ id: "t2", tripType: "roundTrip" })]),
+    record("2026-11-07", { kind: "holiday" }, [trip({ oneWayFare: 999 })]),
+  ];
+
+  it("BOM で始まり、CRLF で区切られ、最後も CRLF", () => {
+    const csv = monthCsv(records);
+    expect(csv.startsWith(UTF8_BOM + CSV_HEADER.join(",") + "\r\n")).toBe(true);
+    expect(csv.endsWith("\r\n")).toBe(true);
+    // CRLF 以外の単独の LF は、エスケープした値の中の改行だけ
+    expect(csv.replaceAll("\r\n", "").match(/\n/g)).toHaveLength(1);
+  });
+
+  it("値にカンマ・改行・\" があれば囲んで出力する", () => {
+    expect(monthCsv(records)).toContain('"A,B ""社""\n打合せ"');
+  });
+
+  it("記録が無ければ見出しだけ", () => {
+    expect(monthCsv([])).toBe(UTF8_BOM + CSV_HEADER.join(",") + "\r\n");
+  });
+
+  it("金額の列の和が monthlyFare の合計と一致する", () => {
+    const sum = monthCsvRows(records).reduce((s, row) => s + Number(row[CSV_HEADER.indexOf("金額")]), 0);
+    expect(sum).toBe(monthlyFare(records).total);
+    expect(sum).toBe(640 + 640 + 200 + 400 + 999);
+  });
+
+  it("移動の無い月でも合計が一致する（0 円）", () => {
+    const only = [record("2026-11-02", { kind: "remote" })];
+    expect(monthCsvRows(only)).toEqual([]);
+    expect(monthlyFare(only).total).toBe(0);
+  });
+});
+
+describe("csvFileName", () => {
+  it("routepense-YYYY-MM.csv", () => {
+    expect(csvFileName("2026-11")).toBe("routepense-2026-11.csv");
+  });
+});
