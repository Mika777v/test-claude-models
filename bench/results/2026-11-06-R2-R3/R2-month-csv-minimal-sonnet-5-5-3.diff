+import { describe, expect, it } from "vitest";
+import { CSV_HEADER, UTF8_BOM, csvFileName, escapeCsvField, monthCsv, monthCsvRows } from "./csv";
+import type { DailyRecord } from "./daily-record";
+import type { ExtraTrip } from "./extra-trip";
+import { monthlyFare } from "./fare";
+import type { WorkStyle } from "./work-style";
+
+type Rec = Pick<DailyRecord, "date" | "workStyle" | "extraTrips">;
+
+const commute: WorkStyle = {
+  kind: "commute",
+  routeId: "r1",
+  route: { name: "自宅↔本社", from: "自宅", to: "本社", transport: "train", oneWayFare: 320 },
+};
+
+function trip(overrides: Partial<ExtraTrip> = {}): ExtraTrip {
+  return { id: "t1", from: "本社", to: "客先B", transport: "bus", oneWayFare: 200, tripType: "oneWay", ...overrides };
+}
+
+const sample: Rec[] = [
+  { date: "2026-11-04", workStyle: commute, extraTrips: [trip({ tripType: "roundTrip", purpose: "客先B打合せ" })] },
+  { date: "2026-11-03", workStyle: { kind: "holiday" }, extraTrips: [] },
+  { date: "2026-11-05", workStyle: { kind: "remote" }, extraTrips: [] },
+  { date: "2026-11-06", workStyle: { kind: "remote" }, extraTrips: [trip()] },
+];
+
+describe("monthCsvRows", () => {
+  it("出勤の通常ルートと追加の移動を1行ずつ、F7 の列の順で作る", () => {
+    const rows = monthCsvRows([sample[0]!]);
+    expect(rows).toEqual([
+      ["2026-11-04", "水", "", "出勤", "通常", "自宅", "本社", "電車", "往復", "320", "640", "自宅↔本社", ""],
+      ["2026-11-04", "水", "", "出勤", "追加", "本社", "客先B", "バス", "往復", "200", "400", "", "客先B打合せ"],
+    ]);
+    expect(rows.every((row) => row.length === CSV_HEADER.length)).toBe(true);
+  });
+
+  it("移動の無い日は行を作らない。祝日名を入れ、日付順に並べる", () => {
+    const rows = monthCsvRows(sample);
+    expect(rows.map((r) => r[0])).toEqual(["2026-11-04", "2026-11-04", "2026-11-06"]);
+    expect(rows[0]?.[2]).toBe("");
+    expect(monthCsvRows([{ date: "2026-11-03", workStyle: { kind: "holiday" }, extraTrips: [trip()] }])[0]?.[2]).toBe(
+      "文化の日",
+    );
+  });
+
+  it("片道の追加の移動は金額が片道運賃と同じ", () => {
+    const row = monthCsvRows([sample[3]!])[0];
+    expect(row?.slice(8, 11)).toEqual(["片道", "200", "200"]);
+  });
+});
+
+describe("escapeCsvField", () => {
+  it("普通の値はそのまま", () => {
+    expect(escapeCsvField("本社")).toBe("本社");
+    expect(escapeCsvField("")).toBe("");
+  });
+
+  it("カンマ・改行・引用符を含む値は囲み、中の引用符は重ねる", () => {
+    expect(escapeCsvField("A,B")).toBe('"A,B"');
+    expect(escapeCsvField("a\nb")).toBe('"a\nb"');
+    expect(escapeCsvField("a\r\nb")).toBe('"a\r\nb"');
+    expect(escapeCsvField('彼は"はい"と言った')).toBe('"彼は""はい""と言った"');
+  });
+});
+
+describe("monthCsv", () => {
+  it("BOM で始まり、CRLF で区切り、最後も CRLF", () => {
+    const csv = monthCsv(sample);
+    expect(csv.startsWith(UTF8_BOM + CSV_HEADER.join(",") + "\r\n")).toBe(true);
+    expect(csv.endsWith("\r\n")).toBe(true);
+    expect(csv.split("\r\n")).toHaveLength(1 + 3 + 1);
+  });
+
+  it("記録が無くても見出しだけのファイルになる", () => {
+    expect(monthCsv([])).toBe(UTF8_BOM + CSV_HEADER.join(",") + "\r\n");
+  });
+
+  it("エスケープが必要な値を含めても、囲んで出力される", () => {
+    const csv = monthCsv([
+      { date: "2026-11-06", workStyle: { kind: "remote" }, extraTrips: [trip({ purpose: 'A社,"B"\n案件' })] },
+    ]);
+    expect(csv).toContain('"A社,""B""\n案件"');
+  });
+
+  it("金額の列の和が monthlyFare の合計と一致する", () => {
+    const rows = monthCsvRows(sample);
+    const amountIndex = CSV_HEADER.indexOf("金額");
+    const sum = rows.reduce((acc, row) => acc + Number(row[amountIndex]), 0);
+    expect(sum).toBe(monthlyFare(sample).total);
+    expect(sum).toBe(640 + 400 + 200);
+  });
+});
+
+describe("csvFileName", () => {
+  it("routepense-YYYY-MM.csv", () => {
+    expect(csvFileName("2026-11")).toBe("routepense-2026-11.csv");
+  });
+});
