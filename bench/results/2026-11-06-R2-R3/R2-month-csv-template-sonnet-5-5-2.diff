+import { describe, expect, it } from "vitest";
+import { CSV_HEADER, UTF8_BOM, csvFileName, escapeCsvField, monthCsv, monthCsvRows } from "./csv";
+import type { CsvRecord } from "./csv";
+import type { ExtraTrip } from "./extra-trip";
+import { monthlyFare } from "./fare";
+
+const commute: CsvRecord["workStyle"] = {
+  kind: "commute",
+  routeId: "route-1",
+  route: { name: "自宅↔本社", from: "自宅", to: "本社", transport: "train", oneWayFare: 320 },
+};
+
+function trip(overrides: Partial<ExtraTrip> = {}): ExtraTrip {
+  return {
+    id: "trip-1",
+    from: "本社",
+    to: "客先B",
+    transport: "bus",
+    oneWayFare: 200,
+    tripType: "oneWay",
+    ...overrides,
+  };
+}
+
+function rec(date: string, workStyle: CsvRecord["workStyle"], extraTrips: ExtraTrip[] = []): CsvRecord {
+  return { date, workStyle, extraTrips };
+}
+
+describe("escapeCsvField", () => {
+  it("特別な文字が無ければそのまま返す", () => {
+    expect(escapeCsvField("自宅↔本社")).toBe("自宅↔本社");
+    expect(escapeCsvField("")).toBe("");
+  });
+
+  it("カンマを含むなら囲む", () => {
+    expect(escapeCsvField("A駅,B駅")).toBe('"A駅,B駅"');
+  });
+
+  it("改行（LF・CRLF・CR）を含むなら囲む", () => {
+    expect(escapeCsvField("a\nb")).toBe('"a\nb"');
+    expect(escapeCsvField("a\r\nb")).toBe('"a\r\nb"');
+    expect(escapeCsvField("a\rb")).toBe('"a\rb"');
+  });
+
+  it('" を含むなら囲み、" を "" に重ねる', () => {
+    expect(escapeCsvField('"急行"')).toBe('"""急行"""');
+    expect(escapeCsvField('a"b')).toBe('"a""b"');
+  });
+});
+
+describe("monthCsvRows", () => {
+  it("出勤は通常ルートの1行（往復・金額は片道×2）。祝日名と曜日が入る", () => {
+    expect(monthCsvRows([rec("2026-11-03", commute)])).toEqual([
+      ["2026-11-03", "火", "文化の日", "出勤", "通常", "自宅", "本社", "電車", "往復", "320", "640", "自宅↔本社", ""],
+    ]);
+  });
+
+  it("列の数は見出しと同じ", () => {
+    const rows = monthCsvRows([rec("2026-11-04", commute, [trip({ purpose: "打合せ" })])]);
+    for (const row of rows) expect(row).toHaveLength(CSV_HEADER.length);
+  });
+
+  it("追加の移動は1件ごとに1行。往復は金額が2倍、ルート名は空、目的が入る", () => {
+    const rows = monthCsvRows([
+      rec("2026-11-04", commute, [
+        trip({ id: "t1", purpose: "客先B打合せ" }),
+        trip({ id: "t2", tripType: "roundTrip", oneWayFare: 150, transport: "other" }),
+      ]),
+    ]);
+    expect(rows).toHaveLength(3);
+    expect(rows[1]).toEqual(["2026-11-04", "水", "", "出勤", "追加", "本社", "客先B", "バス", "片道", "200", "200", "", "客先B打合せ"]);
+    expect(rows[2]).toEqual(["2026-11-04", "水", "", "出勤", "追加", "本社", "客先B", "その他", "往復", "150", "300", "", ""]);
+  });
+
+  it("在宅・休日で追加の移動が無い日は行を作らない", () => {
+    expect(monthCsvRows([rec("2026-11-05", { kind: "remote" }), rec("2026-11-07", { kind: "holiday" })])).toEqual([]);
+  });
+
+  it("在宅・休日でも追加の移動があれば行を作る（勤務区分はそのまま）", () => {
+    const rows = monthCsvRows([rec("2026-11-07", { kind: "holiday" }, [trip()]), rec("2026-11-05", { kind: "remote" }, [trip()])]);
+    expect(rows.map((r) => [r[0], r[3], r[4]])).toEqual([
+      ["2026-11-05", "在宅", "追加"],
+      ["2026-11-07", "休日", "追加"],
+    ]);
+  });
+
+  it("日付の昇順に並べ、渡した配列は変えない", () => {
+    const input = [rec("2026-11-10", commute), rec("2026-11-02", commute)];
+    expect(monthCsvRows(input).map((r) => r[0])).toEqual(["2026-11-02", "2026-11-10"]);
+    expect(input.map((r) => r.date)).toEqual(["2026-11-10", "2026-11-02"]);
+  });
+});
+
+describe("monthCsv", () => {
+  it("BOM・見出し・CRLF・最後の CRLF", () => {
+    const csv = monthCsv([rec("2026-11-04", commute)]);
+    expect(csv.startsWith(UTF8_BOM)).toBe(true);
+    expect(UTF8_BOM).toBe("﻿");
+    const lines = csv.slice(UTF8_BOM.length).split("\r\n");
+    expect(lines[0]).toBe(CSV_HEADER.join(","));
+    expect(lines[1]).toBe("2026-11-04,水,,出勤,通常,自宅,本社,電車,往復,320,640,自宅↔本社,");
+    expect(lines[2]).toBe(""); // 最後の CRLF の後
+    expect(lines).toHaveLength(3);
+  });
+
+  it("記録が無くても見出しの行は入る", () => {
+    expect(monthCsv([])).toBe(UTF8_BOM + CSV_HEADER.join(",") + "\r\n");
+  });
+
+  it("エスケープが効く（カンマ・改行・\"）。行の数は変わらない", () => {
+    const csv = monthCsv([
+      rec("2026-11-04", commute, [trip({ from: "A駅,東口", purpose: '"急ぎ"\n要領収書' })]),
+    ]);
+    expect(csv).toContain('"A駅,東口"');
+    expect(csv).toContain('"""急ぎ""\n要領収書"');
+  });
+
+  it("金額の列の和が monthlyFare の合計と合う", () => {
+    const records = [
+      rec("2026-11-02", commute, [trip({ id: "a" }), trip({ id: "b", tripType: "roundTrip", oneWayFare: 170 })]),
+      rec("2026-11-03", { kind: "remote" }),
+      rec("2026-11-04", commute),
+      rec("2026-11-07", { kind: "holiday" }, [trip({ id: "c", oneWayFare: 1 })]),
+    ];
+    const amountIndex = CSV_HEADER.indexOf("金額");
+    const sum = monthCsvRows(records).reduce((acc, row) => acc + Number(row[amountIndex]), 0);
+    expect(sum).toBe(monthlyFare(records).total);
+    expect(sum).toBe(640 + 200 + 340 + 640 + 1);
+  });
+});
+
+describe("csvFileName", () => {
+  it("routepense-YYYY-MM.csv", () => {
+    expect(csvFileName("2026-11")).toBe("routepense-2026-11.csv");
+  });
+});
