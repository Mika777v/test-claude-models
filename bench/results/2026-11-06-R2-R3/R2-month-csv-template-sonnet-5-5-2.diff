@@ -0,0 +1,154 @@
+import type { DailyRecord } from "./daily-record";
+import { weekdayOf } from "./date";
+import type { Weekday } from "./date";
+import { extraTripFare, assertNever } from "./fare";
+import type { TripType } from "./extra-trip";
+import { holidayName } from "./holidays";
+import type { Transport } from "./route";
+import type { WorkStyleKind } from "./work-style";
+
+/** CSV の元になる記録。DailyRecord のうち、CSV に使う項目だけ */
+export type CsvRecord = Pick<DailyRecord, "date" | "workStyle" | "extraTrips">;
+
+/** 見出しの行（F7 の列の順） */
+export const CSV_HEADER: readonly string[] = [
+  "日付",
+  "曜日",
+  "祝日",
+  "勤務区分",
+  "種別",
+  "出発地",
+  "到着地",
+  "交通手段",
+  "片道/往復",
+  "片道運賃",
+  "金額",
+  "ルート名",
+  "目的",
+];
+
+/** ファイルの先頭に付ける BOM（Excel が UTF-8 と見分けるための印）。U+FEFF */
+export const UTF8_BOM = "﻿";
+
+/** 行の区切り（RFC 4180 は CRLF） */
+const CRLF = "\r\n";
+
+// Record<union, string> にすると、種類を増やして書き忘れたときに型エラーになる
+const WEEKDAY_LABELS: Record<Weekday, string> = {
+  0: "日",
+  1: "月",
+  2: "火",
+  3: "水",
+  4: "木",
+  5: "金",
+  6: "土",
+};
+
+const WORK_STYLE_LABELS: Record<WorkStyleKind, string> = {
+  remote: "在宅",
+  commute: "出勤",
+  holiday: "休日",
+};
+
+const TRANSPORT_LABELS: Record<Transport, string> = {
+  train: "電車",
+  bus: "バス",
+  other: "その他",
+};
+
+const TRIP_TYPE_LABELS: Record<TripType, string> = {
+  oneWay: "片道",
+  roundTrip: "往復",
+};
+
+/**
+ * 月の記録を、CSV の行（F7 の列の順の文字列の配列）の配列にする（純粋関数）。
+ * 値はエスケープする前のもの。エスケープは escapeCsvField / monthCsv が行う。
+ *
+ * - 1行 = 1つの移動。出勤なら通常ルートで1行、追加の移動は1件ごとに1行
+ * - 在宅・休日で追加の移動が無い日は行を作らない（records に入っていない未入力の日も同じ）
+ * - 日付の昇順。同じ日の中は、通常ルート → 追加の移動（足した順）
+ * - 金額の列の和は monthlyFare(records).total と一致する
+ */
+export function monthCsvRows(records: readonly CsvRecord[]): string[][] {
+  // 並べ替えで元の配列を変えないよう、コピーしてから sort する。YYYY-MM-DD は文字列の比較で日付順になる
+  const sorted = [...records].sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
+  const rows: string[][] = [];
+
+  for (const record of sorted) {
+    const { date, workStyle } = record;
+    // 日付・曜日・祝日・勤務区分は、その日の行すべてに共通
+    const dayColumns = [
+      date,
+      WEEKDAY_LABELS[weekdayOf(date)],
+      holidayName(date) ?? "",
+      WORK_STYLE_LABELS[workStyle.kind],
+    ];
+
+    switch (workStyle.kind) {
+      case "commute": {
+        const { route } = workStyle;
+        rows.push([
+          ...dayColumns,
+          "通常",
+          route.from,
+          route.to,
+          TRANSPORT_LABELS[route.transport],
+          TRIP_TYPE_LABELS.roundTrip, // 通常の出勤は常に往復
+          String(route.oneWayFare),
+          String(route.oneWayFare * 2),
+          route.name,
+          "",
+        ]);
+        break;
+      }
+      case "remote":
+      case "holiday":
+        break;
+      default:
+        assertNever(workStyle);
+    }
+
+    for (const trip of record.extraTrips) {
+      rows.push([
+        ...dayColumns,
+        "追加",
+        trip.from,
+        trip.to,
+        TRANSPORT_LABELS[trip.transport],
+        TRIP_TYPE_LABELS[trip.tripType],
+        String(trip.oneWayFare),
+        String(extraTripFare(trip)),
+        "", // 追加の移動はルート名を持たない
+        trip.purpose ?? "",
+      ]);
+    }
+  }
+
+  return rows;
+}
+
+/**
+ * 1つの値を CSV 用にエスケープする（RFC 4180）。
+ * カンマ・改行（CR / LF）・`"` のどれかを含むなら、全体を `"` で囲み、中の `"` は `""` に重ねる。
+ * 含まなければそのまま返す。
+ */
+export function escapeCsvField(value: string): string {
+  if (!/[",\r\n]/.test(value)) return value;
+  return `"${value.replaceAll('"', '""')}"`;
+}
+
+/**
+ * 月の記録から CSV ファイルの中身全体を作る（純粋関数）。
+ * 先頭に BOM、1行目は見出し、行の区切りは CRLF で、最後の行にも CRLF を付ける。
+ * 記録が無くても見出しの行は入る。合計の行は入れない。
+ */
+export function monthCsv(records: readonly CsvRecord[]): string {
+  const lines = [CSV_HEADER, ...monthCsvRows(records)].map((row) => row.map(escapeCsvField).join(","));
+  return UTF8_BOM + lines.join(CRLF) + CRLF;
+}
+
+/** ファイル名。month は YYYY-MM（例: "2026-11" → "routepense-2026-11.csv"） */
+export function csvFileName(month: string): string {
+  return `routepense-${month}.csv`;
+}
