@@ -0,0 +1,110 @@
+import type { DailyRecord } from "./daily-record";
+import { weekdayOf } from "./date";
+import type { ExtraTrip } from "./extra-trip";
+import { extraTripFare } from "./fare";
+import { holidayName } from "./holidays";
+import type { Transport } from "./route";
+
+/** CSV の1行に必要な記録の部分。日次記録（DailyRecord）はそのまま渡せる */
+export type CsvRecord = Pick<DailyRecord, "date" | "workStyle" | "extraTrips">;
+
+/** F7 の列の名前（この順） */
+export const CSV_HEADER: readonly string[] = [
+  "日付",
+  "曜日",
+  "祝日",
+  "勤務区分",
+  "種別",
+  "出発地",
+  "到着地",
+  "交通手段",
+  "片道/往復",
+  "片道運賃",
+  "金額",
+  "ルート名",
+  "目的",
+];
+
+/** ファイルの先頭に付ける BOM（Excel が UTF-8 と判定するため） */
+export const UTF8_BOM = "﻿";
+
+const WEEKDAY_LABELS = ["日", "月", "火", "水", "木", "金", "土"] as const;
+
+const TRANSPORT_LABELS: Record<Transport, string> = {
+  train: "電車",
+  bus: "バス",
+  other: "その他",
+};
+
+const WORK_STYLE_LABELS = { remote: "在宅", commute: "出勤", holiday: "休日" } as const;
+
+function extraTripRow(prefix: string[], trip: ExtraTrip): string[] {
+  return [
+    ...prefix,
+    "追加",
+    trip.from,
+    trip.to,
+    TRANSPORT_LABELS[trip.transport],
+    trip.tripType === "roundTrip" ? "往復" : "片道",
+    String(trip.oneWayFare),
+    String(extraTripFare(trip)),
+    "",
+    trip.purpose ?? "",
+  ];
+}
+
+/**
+ * 月の記録から、CSV の明細の行を作る（エスケープする前の値。見出しは含まない）。
+ * 出勤日は通常ルートで1行、追加の移動は1件ごとに1行。移動の無い日は行を作らない。
+ * 行の順は、records の順（日付順に渡せば日付順）、同じ日の中は通常 → 追加の順。
+ */
+export function monthCsvRows(records: readonly CsvRecord[]): string[][] {
+  return records.flatMap((record) => {
+    const { date, workStyle } = record;
+    const prefix = [
+      date,
+      WEEKDAY_LABELS[weekdayOf(date)],
+      holidayName(date) ?? "",
+      WORK_STYLE_LABELS[workStyle.kind],
+    ];
+    const rows: string[][] = [];
+    if (workStyle.kind === "commute") {
+      const { route } = workStyle;
+      rows.push([
+        ...prefix,
+        "通常",
+        route.from,
+        route.to,
+        TRANSPORT_LABELS[route.transport],
+        "往復",
+        String(route.oneWayFare),
+        String(route.oneWayFare * 2),
+        route.name,
+        "",
+      ]);
+    }
+    for (const trip of record.extraTrips) {
+      rows.push(extraTripRow(prefix, trip));
+    }
+    return rows;
+  });
+}
+
+/** 値を1つ、CSV 用にエスケープする。カンマ・改行・`"` を含むときだけ `"` で囲み、中の `"` は `""` にする（RFC 4180） */
+export function escapeCsvField(value: string): string {
+  if (/[",\r\n]/.test(value)) {
+    return `"${value.replaceAll('"', '""')}"`;
+  }
+  return value;
+}
+
+/** CSV のファイルの中身全体: BOM + 見出し + 明細。改行は CRLF で、最後の行にも付ける */
+export function monthCsv(records: readonly CsvRecord[]): string {
+  const lines = [CSV_HEADER, ...monthCsvRows(records)].map((row) => row.map(escapeCsvField).join(","));
+  return UTF8_BOM + lines.map((line) => `${line}\r\n`).join("");
+}
+
+/** month（YYYY-MM）から、ファイル名（routepense-YYYY-MM.csv）を返す */
+export function csvFileName(month: string): string {
+  return `routepense-${month}.csv`;
+}
