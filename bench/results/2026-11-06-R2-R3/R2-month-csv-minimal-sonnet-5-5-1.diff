@@ -0,0 +1,120 @@
+import { describe, expect, it } from "vitest";
+import { CSV_HEADER, UTF8_BOM, csvFileName, escapeCsvField, monthCsv, monthCsvRows, type CsvRecord } from "./csv";
+import type { ExtraTrip } from "./extra-trip";
+import { monthlyFare } from "./fare";
+
+const commute: CsvRecord["workStyle"] = {
+  kind: "commute",
+  routeId: "route-1",
+  route: { name: "自宅↔本社", from: "自宅", to: "本社", transport: "train", oneWayFare: 320 },
+};
+
+function trip(overrides: Partial<ExtraTrip> = {}): ExtraTrip {
+  return {
+    id: "t1",
+    from: "本社",
+    to: "客先B",
+    transport: "bus",
+    oneWayFare: 200,
+    tripType: "roundTrip",
+    purpose: "客先B打合せ",
+    ...overrides,
+  };
+}
+
+const records: CsvRecord[] = [
+  { date: "2026-11-03", workStyle: { kind: "holiday" }, extraTrips: [] },
+  { date: "2026-11-04", workStyle: commute, extraTrips: [trip(), trip({ tripType: "oneWay", oneWayFare: 150, purpose: undefined })] },
+  { date: "2026-11-05", workStyle: { kind: "remote" }, extraTrips: [] },
+  { date: "2026-11-07", workStyle: { kind: "holiday" }, extraTrips: [trip({ tripType: "oneWay" })] },
+];
+
+function amountSum(rows: string[][]): number {
+  const col = CSV_HEADER.indexOf("金額");
+  return rows.reduce((sum, row) => sum + Number(row[col]), 0);
+}
+
+describe("monthCsvRows", () => {
+  const rows = monthCsvRows(records);
+
+  it("移動の無い日（在宅・休日・追加なし）は行を作らない", () => {
+    expect(rows.map((r) => r[0])).toEqual(["2026-11-04", "2026-11-04", "2026-11-04", "2026-11-07"]);
+  });
+
+  it("出勤日の通常ルートは往復で1行、F7 の列の順", () => {
+    expect(rows[0]).toEqual([
+      "2026-11-04", "水", "", "出勤", "通常", "自宅", "本社", "電車", "往復", "320", "640", "自宅↔本社", "",
+    ]);
+    expect(rows[0]).toHaveLength(CSV_HEADER.length);
+  });
+
+  it("追加の移動は1件ごとに1行。ルート名は空で、目的を入れる", () => {
+    expect(rows[1]).toEqual([
+      "2026-11-04", "水", "", "出勤", "追加", "本社", "客先B", "バス", "往復", "200", "400", "", "客先B打合せ",
+    ]);
+    expect(rows[2]?.[8]).toBe("片道");
+    expect(rows[2]?.[12]).toBe("");
+  });
+
+  it("祝日名と曜日が入る。休日の追加の移動も行になる", () => {
+    expect(rows[3]?.slice(0, 5)).toEqual(["2026-11-07", "土", "", "休日", "追加"]);
+    const [holiday] = monthCsvRows([{ date: "2026-11-03", workStyle: { kind: "holiday" }, extraTrips: [trip()] }]);
+    expect(holiday?.slice(0, 4)).toEqual(["2026-11-03", "火", "文化の日", "休日"]);
+  });
+
+  it("記録が無ければ行も無い", () => {
+    expect(monthCsvRows([])).toEqual([]);
+  });
+
+  it("金額の列の和が monthlyFare の合計と合う", () => {
+    expect(amountSum(rows)).toBe(monthlyFare(records).total);
+    expect(amountSum(rows)).toBe(640 + 400 + 150 + 200);
+  });
+});
+
+describe("escapeCsvField", () => {
+  it("ふつうの値はそのまま", () => {
+    expect(escapeCsvField("自宅↔本社")).toBe("自宅↔本社");
+    expect(escapeCsvField("")).toBe("");
+  });
+
+  it("カンマを含むと囲む", () => {
+    expect(escapeCsvField("A,B")).toBe('"A,B"');
+  });
+
+  it("改行（LF・CR）を含むと囲む", () => {
+    expect(escapeCsvField("a\nb")).toBe('"a\nb"');
+    expect(escapeCsvField("a\rb")).toBe('"a\rb"');
+  });
+
+  it('`"` は `""` にして囲む（すべての `"` を直す）', () => {
+    expect(escapeCsvField('say "hi" "ok"')).toBe('"say ""hi"" ""ok"""');
+  });
+});
+
+describe("monthCsv", () => {
+  it("BOM で始まり、見出し・明細が CRLF で区切られる", () => {
+    const csv = monthCsv(records);
+    expect(csv.startsWith(UTF8_BOM + CSV_HEADER.join(",") + "\r\n")).toBe(true);
+    expect(csv.endsWith("\r\n")).toBe(true);
+    expect(csv.slice(1).split("\r\n")).toHaveLength(1 + 4 + 1);
+    expect(csv.replaceAll("\r\n", "")).not.toContain("\n");
+  });
+
+  it("記録が無くても見出しだけは出る", () => {
+    expect(monthCsv([])).toBe(UTF8_BOM + CSV_HEADER.join(",") + "\r\n");
+  });
+
+  it("特殊な文字を含む値は囲まれ、列の数が崩れない", () => {
+    const csv = monthCsv([
+      { date: "2026-11-04", workStyle: { kind: "remote" }, extraTrips: [trip({ purpose: 'A,"B"\nC' })] },
+    ]);
+    expect(csv).toContain(',"A,""B""\nC"\r\n');
+  });
+});
+
+describe("csvFileName", () => {
+  it("routepense-YYYY-MM.csv", () => {
+    expect(csvFileName("2026-11")).toBe("routepense-2026-11.csv");
+  });
+});
