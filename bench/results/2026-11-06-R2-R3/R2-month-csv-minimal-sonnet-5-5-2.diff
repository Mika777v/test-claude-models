+import { describe, expect, it } from "vitest";
+import { CSV_HEADER, UTF8_BOM, csvFileName, escapeCsvField, monthCsv, monthCsvRows, type CsvRecord } from "./csv";
+import type { ExtraTrip } from "./extra-trip";
+import { monthlyFare } from "./fare";
+
+const commute: CsvRecord["workStyle"] = {
+  kind: "commute",
+  routeId: "route-1",
+  route: { name: "自宅↔本社", from: "自宅", to: "本社", transport: "train", oneWayFare: 320 },
+};
+
+function trip(overrides: Partial<ExtraTrip> = {}): ExtraTrip {
+  return {
+    id: "trip-1",
+    from: "本社",
+    to: "客先B",
+    transport: "bus",
+    oneWayFare: 200,
+    tripType: "roundTrip",
+    purpose: "客先B打合せ",
+    ...overrides,
+  };
+}
+
+describe("monthCsvRows", () => {
+  it("出勤日は通常ルートで1行、追加の移動ごとに1行（F7 の列の順）", () => {
+    const rows = monthCsvRows([{ date: "2026-11-04", workStyle: commute, extraTrips: [trip()] }]);
+    expect(rows).toEqual([
+      ["2026-11-04", "水", "", "出勤", "通常", "自宅", "本社", "電車", "往復", "320", "640", "自宅↔本社", ""],
+      ["2026-11-04", "水", "", "出勤", "追加", "本社", "客先B", "バス", "往復", "200", "400", "", "客先B打合せ"],
+    ]);
+    expect(rows.every((row) => row.length === CSV_HEADER.length)).toBe(true);
+  });
+
+  it("祝日名が入り、片道は片道運賃のまま", () => {
+    const rows = monthCsvRows([
+      { date: "2026-11-03", workStyle: { kind: "holiday" }, extraTrips: [trip({ tripType: "oneWay", purpose: undefined })] },
+    ]);
+    expect(rows).toEqual([
+      ["2026-11-03", "火", "文化の日", "休日", "追加", "本社", "客先B", "バス", "片道", "200", "200", "", ""],
+    ]);
+  });
+
+  it("在宅・休日で追加の移動が無い日は行を作らない", () => {
+    expect(
+      monthCsvRows([
+        { date: "2026-11-05", workStyle: { kind: "remote" }, extraTrips: [] },
+        { date: "2026-11-07", workStyle: { kind: "holiday" }, extraTrips: [] },
+      ]),
+    ).toEqual([]);
+  });
+
+  it("日付順に並べ、渡した配列は変えない", () => {
+    const records: CsvRecord[] = [
+      { date: "2026-11-05", workStyle: commute, extraTrips: [] },
+      { date: "2026-11-04", workStyle: commute, extraTrips: [] },
+    ];
+    expect(monthCsvRows(records).map((row) => row[0])).toEqual(["2026-11-04", "2026-11-05"]);
+    expect(records[0]?.date).toBe("2026-11-05");
+  });
+});
+
+describe("escapeCsvField", () => {
+  it("特別な文字が無ければそのまま", () => {
+    expect(escapeCsvField("自宅↔本社")).toBe("自宅↔本社");
+    expect(escapeCsvField("")).toBe("");
+  });
+
+  it("カンマを含めば囲む", () => {
+    expect(escapeCsvField("A駅,B駅")).toBe('"A駅,B駅"');
+  });
+
+  it("改行（LF・CRLF）を含めば囲む", () => {
+    expect(escapeCsvField("1行目\n2行目")).toBe('"1行目\n2行目"');
+    expect(escapeCsvField("1行目\r\n2行目")).toBe('"1行目\r\n2行目"');
+  });
+
+  it('`"` は `""` にして囲む', () => {
+    expect(escapeCsvField('"急行"で')).toBe('"""急行""で"');
+  });
+});
+
+describe("monthCsv", () => {
+  it("BOM・見出し・CRLF で、最後も CRLF", () => {
+    const csv = monthCsv([{ date: "2026-11-04", workStyle: commute, extraTrips: [] }]);
+    expect(csv.startsWith(UTF8_BOM + CSV_HEADER.join(",") + "\r\n2026-11-04,")).toBe(true);
+    expect(csv.endsWith("\r\n")).toBe(true);
+    expect(csv.replaceAll("\r\n", "")).not.toMatch(/[\r\n]/);
+  });
+
+  it("記録が無ければ見出しだけ", () => {
+    expect(monthCsv([])).toBe(UTF8_BOM + CSV_HEADER.join(",") + "\r\n");
+  });
+
+  it("カンマ・改行・引用符を含む値は、囲まれて1つの値のまま残る", () => {
+    const csv = monthCsv([
+      {
+        date: "2026-11-04",
+        workStyle: { kind: "remote" },
+        extraTrips: [trip({ from: "A駅,北口", purpose: '"急ぎ"の\n打合せ' })],
+      },
+    ]);
+    expect(csv).toContain('"A駅,北口"');
+    expect(csv).toContain('"""急ぎ""の\n打合せ"');
+  });
+
+  it("金額の列の和が monthlyFare の合計と合う（在宅・休日・追加の移動を含む月）", () => {
+    const records: CsvRecord[] = [
+      { date: "2026-11-02", workStyle: commute, extraTrips: [] },
+      { date: "2026-11-03", workStyle: { kind: "holiday" }, extraTrips: [trip({ tripType: "oneWay" })] },
+      { date: "2026-11-04", workStyle: commute, extraTrips: [trip(), trip({ id: "trip-2", oneWayFare: 150 })] },
+      { date: "2026-11-05", workStyle: { kind: "remote" }, extraTrips: [] },
+      { date: "2026-11-06", workStyle: { kind: "remote" }, extraTrips: [trip({ oneWayFare: 99 })] },
+    ];
+    const amountIndex = CSV_HEADER.indexOf("金額");
+    const sum = monthCsvRows(records).reduce((acc, row) => acc + Number(row[amountIndex]), 0);
+    expect(sum).toBe(monthlyFare(records).total);
+    expect(sum).toBeGreaterThan(0);
+  });
+});
+
+describe("csvFileName", () => {
+  it("routepense-YYYY-MM.csv", () => {
+    expect(csvFileName("2026-11")).toBe("routepense-2026-11.csv");
+  });
+});
