+import { describe, expect, it } from "vitest";
+import { CSV_HEADER, UTF8_BOM, csvFileName, escapeCsvField, monthCsv, monthCsvRows } from "./csv";
+import type { DailyRecord } from "./daily-record";
+import { monthlyFare } from "./fare";
+import type { ExtraTrip } from "./extra-trip";
+
+type Rec = Pick<DailyRecord, "date" | "workStyle" | "extraTrips">;
+
+const route = { name: "自宅↔本社", from: "自宅", to: "本社", transport: "train", oneWayFare: 320 } as const;
+const trip = (overrides: Partial<ExtraTrip> = {}): ExtraTrip => ({
+  id: "t1",
+  from: "本社",
+  to: "客先B",
+  transport: "bus",
+  oneWayFare: 200,
+  tripType: "oneWay",
+  ...overrides,
+});
+
+const commute: Rec = { date: "2026-11-04", workStyle: { kind: "commute", routeId: "r1", route }, extraTrips: [] };
+
+describe("monthCsvRows", () => {
+  it("出勤日の通常ルートは往復で1行（曜日・祝日つき）", () => {
+    expect(monthCsvRows([{ ...commute, date: "2026-11-03" }])).toEqual([
+      ["2026-11-03", "火", "文化の日", "出勤", "通常", "自宅", "本社", "電車", "往復", "320", "640", "自宅↔本社", ""],
+    ]);
+  });
+
+  it("追加の移動は1件ごとに1行。ルート名は空、目的は入る", () => {
+    const rows = monthCsvRows([
+      {
+        ...commute,
+        extraTrips: [trip({ purpose: "客先B打合せ" }), trip({ id: "t2", tripType: "roundTrip" })],
+      },
+    ]);
+    expect(rows).toHaveLength(3);
+    expect(rows[1]).toEqual(["2026-11-04", "水", "", "出勤", "追加", "本社", "客先B", "バス", "片道", "200", "200", "", "客先B打合せ"]);
+    expect(rows[2]?.slice(8, 13)).toEqual(["往復", "200", "400", "", ""]);
+  });
+
+  it("在宅・休日で追加の移動が無い日は行を作らない。追加があれば行になる", () => {
+    const rows = monthCsvRows([
+      { date: "2026-11-05", workStyle: { kind: "remote" }, extraTrips: [] },
+      { date: "2026-11-07", workStyle: { kind: "holiday" }, extraTrips: [] },
+      { date: "2026-11-08", workStyle: { kind: "holiday" }, extraTrips: [trip()] },
+    ]);
+    expect(rows).toHaveLength(1);
+    expect(rows[0]?.slice(0, 5)).toEqual(["2026-11-08", "日", "", "休日", "追加"]);
+  });
+
+  it("すべての行が見出しと同じ列数", () => {
+    const rows = monthCsvRows([{ ...commute, extraTrips: [trip()] }]);
+    for (const row of rows) expect(row).toHaveLength(CSV_HEADER.length);
+  });
+});
+
+describe("escapeCsvField", () => {
+  it("ふつうの値はそのまま", () => {
+    expect(escapeCsvField("自宅↔本社")).toBe("自宅↔本社");
+    expect(escapeCsvField("")).toBe("");
+  });
+
+  it("カンマ・改行・\" を含む値は \" で囲み、\" は二重にする", () => {
+    expect(escapeCsvField("a,b")).toBe('"a,b"');
+    expect(escapeCsvField("a\nb")).toBe('"a\nb"');
+    expect(escapeCsvField("a\r\nb")).toBe('"a\r\nb"');
+    expect(escapeCsvField('say "hi"')).toBe('"say ""hi"""');
+  });
+});
+
+describe("monthCsv", () => {
+  it("BOM・見出し・CRLF で、特殊文字を含む値はエスケープされる", () => {
+    const csv = monthCsv([{ ...commute, extraTrips: [trip({ purpose: 'A社, "B"\n打合せ' })] }]);
+    expect(csv.startsWith(UTF8_BOM + CSV_HEADER.join(",") + "\r\n")).toBe(true);
+    expect(csv.endsWith("\r\n")).toBe(true);
+    expect(csv).toContain('"A社, ""B""\n打合せ"');
+    // 値の中の改行（LF）を除くと、行区切りはすべて CRLF
+    expect(csv.replaceAll("\r\n", "").includes("\r")).toBe(false);
+  });
+
+  it("記録が無ければ見出しだけ", () => {
+    expect(monthCsv([])).toBe(UTF8_BOM + CSV_HEADER.join(",") + "\r\n");
+  });
+
+  it("金額の列の和が monthlyFare の合計と一致する", () => {
+    const records: Rec[] = [
+      { ...commute, extraTrips: [trip(), trip({ id: "t2", tripType: "roundTrip", oneWayFare: 150 })] },
+      { date: "2026-11-05", workStyle: { kind: "remote" }, extraTrips: [trip({ oneWayFare: 480 })] },
+      { date: "2026-11-06", workStyle: { kind: "holiday" }, extraTrips: [] },
+      { ...commute, date: "2026-11-09" },
+    ];
+    const amountIndex = CSV_HEADER.indexOf("金額");
+    const sum = monthCsvRows(records).reduce((acc, row) => acc + Number(row[amountIndex]), 0);
+    expect(sum).toBe(monthlyFare(records).total);
+    expect(sum).toBe(640 + 200 + 300 + 480 + 640);
+  });
+});
+
+describe("csvFileName", () => {
+  it("routepense-YYYY-MM.csv", () => {
+    expect(csvFileName("2026-11")).toBe("routepense-2026-11.csv");
+  });
+});
