@@ -0,0 +1,127 @@
+import type { DailyRecord } from "./daily-record";
+import type { DateString, Weekday } from "./date";
+import { weekdayOf } from "./date";
+import { extraTripFare } from "./fare";
+import { holidayName } from "./holidays";
+import type { Transport } from "./route";
+import type { TripType } from "./extra-trip";
+import type { WorkStyleKind } from "./work-style";
+
+/** F7 の列の名前（この順） */
+export const CSV_HEADER: readonly string[] = [
+  "日付",
+  "曜日",
+  "祝日",
+  "勤務区分",
+  "種別",
+  "出発地",
+  "到着地",
+  "交通手段",
+  "片道/往復",
+  "片道運賃",
+  "金額",
+  "ルート名",
+  "目的",
+];
+
+/** ファイルの先頭に付ける BOM（表計算ソフトが UTF-8 と判別できるようにする） */
+export const UTF8_BOM = "﻿";
+
+/** CSV の改行（RFC 4180） */
+const CRLF = "\r\n";
+
+const WEEKDAY_NAMES: Record<Weekday, string> = {
+  0: "日",
+  1: "月",
+  2: "火",
+  3: "水",
+  4: "木",
+  5: "金",
+  6: "土",
+};
+
+const WORK_STYLE_NAMES: Record<WorkStyleKind, string> = {
+  remote: "在宅",
+  commute: "出勤",
+  holiday: "休日",
+};
+
+const TRANSPORT_NAMES: Record<Transport, string> = {
+  train: "電車",
+  bus: "バス",
+  other: "その他",
+};
+
+const TRIP_TYPE_NAMES: Record<TripType, string> = {
+  oneWay: "片道",
+  roundTrip: "往復",
+};
+
+type CsvSource = Pick<DailyRecord, "date" | "workStyle" | "extraTrips">;
+
+/**
+ * 月の日次記録から、CSV の行（エスケープする前の値）を作る。
+ * 日付の昇順。同じ日は通常ルート、追加の移動（渡された順）の順。
+ * 交通費が発生しない日（在宅・休日で追加の移動なし）は行を作らない。
+ */
+export function monthCsvRows(records: readonly CsvSource[]): string[][] {
+  const sorted = [...records].sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
+  return sorted.flatMap((record) => rowsOfDay(record));
+}
+
+function rowsOfDay(record: CsvSource): string[][] {
+  const day = [
+    record.date as DateString,
+    WEEKDAY_NAMES[weekdayOf(record.date)],
+    holidayName(record.date) ?? "",
+    WORK_STYLE_NAMES[record.workStyle.kind],
+  ];
+  const rows: string[][] = [];
+  if (record.workStyle.kind === "commute") {
+    const route = record.workStyle.route;
+    rows.push([
+      ...day,
+      "通常",
+      route.from,
+      route.to,
+      TRANSPORT_NAMES[route.transport],
+      TRIP_TYPE_NAMES.roundTrip,
+      String(route.oneWayFare),
+      String(route.oneWayFare * 2),
+      route.name,
+      "",
+    ]);
+  }
+  for (const trip of record.extraTrips) {
+    rows.push([
+      ...day,
+      "追加",
+      trip.from,
+      trip.to,
+      TRANSPORT_NAMES[trip.transport],
+      TRIP_TYPE_NAMES[trip.tripType],
+      String(trip.oneWayFare),
+      String(extraTripFare(trip)),
+      "",
+      trip.purpose ?? "",
+    ]);
+  }
+  return rows;
+}
+
+/** 1つの値のエスケープ（RFC 4180）。カンマ・改行・`"` があれば `"` で囲み、中の `"` は `""` にする */
+export function escapeCsvField(value: string): string {
+  if (!/[",\r\n]/.test(value)) return value;
+  return `"${value.replaceAll('"', '""')}"`;
+}
+
+/** CSV のファイルの中身全体。BOM + 見出し + 明細、改行は CRLF（最後の行にも付ける） */
+export function monthCsv(records: readonly CsvSource[]): string {
+  const lines = [CSV_HEADER, ...monthCsvRows(records)].map((row) => row.map(escapeCsvField).join(","));
+  return UTF8_BOM + lines.map((line) => line + CRLF).join("");
+}
+
+/** `YYYY-MM` からファイル名を返す */
+export function csvFileName(month: string): string {
+  return `routepense-${month}.csv`;
+}
