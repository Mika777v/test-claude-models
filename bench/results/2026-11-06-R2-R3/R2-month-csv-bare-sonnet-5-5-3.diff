@@ -0,0 +1,151 @@
+import { describe, expect, it } from "vitest";
+import { CSV_HEADER, UTF8_BOM, csvFileName, escapeCsvField, monthCsv, monthCsvRows } from "./csv";
+import type { DailyRecord } from "./daily-record";
+import type { ExtraTrip } from "./extra-trip";
+import { monthlyFare } from "./fare";
+import type { WorkStyle } from "./work-style";
+
+type Rec = Pick<DailyRecord, "date" | "workStyle" | "extraTrips">;
+
+const commute: WorkStyle = {
+  kind: "commute",
+  routeId: "route-1",
+  route: { name: "自宅↔本社", from: "自宅", to: "本社", transport: "train", oneWayFare: 320 },
+};
+
+function trip(overrides: Partial<ExtraTrip> = {}): ExtraTrip {
+  return {
+    id: "t1",
+    from: "本社",
+    to: "客先B",
+    transport: "bus",
+    oneWayFare: 210,
+    tripType: "oneWay",
+    ...overrides,
+  };
+}
+
+/** 金額の列（11列目）の和 */
+function sumOfAmounts(rows: string[][]): number {
+  return rows.reduce((sum, row) => sum + Number(row[10]), 0);
+}
+
+describe("escapeCsvField", () => {
+  it("普通の値はそのまま", () => {
+    expect(escapeCsvField("本社")).toBe("本社");
+    expect(escapeCsvField("")).toBe("");
+  });
+
+  it("カンマを含むと囲む", () => {
+    expect(escapeCsvField("A,B")).toBe('"A,B"');
+  });
+
+  it("改行（LF・CRLF）を含むと囲む", () => {
+    expect(escapeCsvField("a\nb")).toBe('"a\nb"');
+    expect(escapeCsvField("a\r\nb")).toBe('"a\r\nb"');
+  });
+
+  it('`"` は `""` にして囲む', () => {
+    expect(escapeCsvField('say "hi"')).toBe('"say ""hi"""');
+  });
+});
+
+describe("monthCsvRows", () => {
+  it("出勤日は通常ルートの1行（往復）", () => {
+    // 2026-11-04 は水曜、祝日ではない
+    expect(monthCsvRows([{ date: "2026-11-04", workStyle: commute, extraTrips: [] }])).toEqual([
+      ["2026-11-04", "水", "", "出勤", "通常", "自宅", "本社", "電車", "往復", "320", "640", "自宅↔本社", ""],
+    ]);
+  });
+
+  it("祝日名が入る", () => {
+    const rows = monthCsvRows([{ date: "2026-11-03", workStyle: commute, extraTrips: [] }]);
+    expect(rows[0]?.[2]).toBe("文化の日");
+  });
+
+  it("追加の移動は1件ごとに1行。往復は2倍、ルート名は空、目的が入る", () => {
+    const rows = monthCsvRows([
+      {
+        date: "2026-11-04",
+        workStyle: { kind: "remote" },
+        extraTrips: [trip({ purpose: "打合せ" }), trip({ id: "t2", tripType: "roundTrip" })],
+      },
+    ]);
+    expect(rows).toEqual([
+      ["2026-11-04", "水", "", "在宅", "追加", "本社", "客先B", "バス", "片道", "210", "210", "", "打合せ"],
+      ["2026-11-04", "水", "", "在宅", "追加", "本社", "客先B", "バス", "往復", "210", "420", "", ""],
+    ]);
+  });
+
+  it("出勤日の追加の移動は通常の次の行", () => {
+    const rows = monthCsvRows([{ date: "2026-11-04", workStyle: commute, extraTrips: [trip()] }]);
+    expect(rows.map((r) => r[4])).toEqual(["通常", "追加"]);
+  });
+
+  it("交通費が出ない日（在宅・休日で追加なし）は行を作らない", () => {
+    expect(
+      monthCsvRows([
+        { date: "2026-11-04", workStyle: { kind: "remote" }, extraTrips: [] },
+        { date: "2026-11-07", workStyle: { kind: "holiday" }, extraTrips: [] },
+      ]),
+    ).toEqual([]);
+  });
+
+  it("日付の昇順に並べ、渡された配列は変えない", () => {
+    const records: Rec[] = [
+      { date: "2026-11-05", workStyle: commute, extraTrips: [] },
+      { date: "2026-11-04", workStyle: commute, extraTrips: [] },
+    ];
+    expect(monthCsvRows(records).map((r) => r[0])).toEqual(["2026-11-04", "2026-11-05"]);
+    expect(records[0]?.date).toBe("2026-11-05");
+  });
+
+  it("全ての行が見出しと同じ列数", () => {
+    const rows = monthCsvRows([{ date: "2026-11-04", workStyle: commute, extraTrips: [trip()] }]);
+    for (const row of rows) expect(row).toHaveLength(CSV_HEADER.length);
+  });
+
+  it("金額の和が monthlyFare の合計と一致する", () => {
+    const records: Rec[] = [
+      { date: "2026-11-02", workStyle: commute, extraTrips: [trip(), trip({ id: "t2", tripType: "roundTrip" })] },
+      { date: "2026-11-03", workStyle: { kind: "holiday" }, extraTrips: [] },
+      { date: "2026-11-04", workStyle: { kind: "remote" }, extraTrips: [trip({ oneWayFare: 150 })] },
+      { date: "2026-11-05", workStyle: commute, extraTrips: [] },
+    ];
+    expect(sumOfAmounts(monthCsvRows(records))).toBe(monthlyFare(records).total);
+    expect(sumOfAmounts(monthCsvRows([]))).toBe(monthlyFare([]).total);
+  });
+});
+
+describe("monthCsv", () => {
+  it("BOM で始まり、見出しの次に明細、全ての行が CRLF で終わる", () => {
+    const csv = monthCsv([{ date: "2026-11-04", workStyle: commute, extraTrips: [] }]);
+    expect(csv.startsWith(UTF8_BOM)).toBe(true);
+    expect(csv.slice(UTF8_BOM.length)).toBe(
+      "日付,曜日,祝日,勤務区分,種別,出発地,到着地,交通手段,片道/往復,片道運賃,金額,ルート名,目的\r\n" +
+        "2026-11-04,水,,出勤,通常,自宅,本社,電車,往復,320,640,自宅↔本社,\r\n",
+    );
+  });
+
+  it("記録が無くても見出しだけのファイルになる", () => {
+    expect(monthCsv([])).toBe(`${UTF8_BOM}${CSV_HEADER.join(",")}\r\n`);
+  });
+
+  it("特殊文字を含む値はエスケープされ、列の数が崩れない", () => {
+    const csv = monthCsv([
+      {
+        date: "2026-11-04",
+        workStyle: { kind: "remote" },
+        extraTrips: [trip({ from: "A,B", purpose: '会議 "重要"\n2回目' })],
+      },
+    ]);
+    expect(csv).toContain('"A,B"');
+    expect(csv).toContain('"会議 ""重要""\n2回目"');
+  });
+});
+
+describe("csvFileName", () => {
+  it("routepense-YYYY-MM.csv", () => {
+    expect(csvFileName("2026-11")).toBe("routepense-2026-11.csv");
+  });
+});
