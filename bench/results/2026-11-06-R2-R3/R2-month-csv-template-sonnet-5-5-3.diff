@@ -0,0 +1,113 @@
+import { describe, expect, it } from "vitest";
+import { CSV_HEADER, csvFileName, escapeCsvField, monthCsv, monthCsvRows, UTF8_BOM } from "./csv";
+import type { CsvRecord } from "./csv";
+import { monthlyFare } from "./fare";
+import type { ExtraTrip } from "./extra-trip";
+
+const commute: CsvRecord["workStyle"] = {
+  kind: "commute",
+  routeId: "route-1",
+  route: { name: "自宅↔本社", from: "自宅", to: "本社", transport: "train", oneWayFare: 320 },
+};
+
+function trip(overrides: Partial<ExtraTrip> = {}): ExtraTrip {
+  return { id: "t", from: "本社", to: "客先B", transport: "bus", oneWayFare: 200, tripType: "oneWay", ...overrides };
+}
+
+function rec(date: string, workStyle: CsvRecord["workStyle"], extraTrips: ExtraTrip[] = []): CsvRecord {
+  return { date, workStyle, extraTrips };
+}
+
+describe("escapeCsvField", () => {
+  it("普通の値はそのまま", () => {
+    expect(escapeCsvField("自宅")).toBe("自宅");
+    expect(escapeCsvField("")).toBe("");
+  });
+  it("カンマを含む値は囲む", () => {
+    expect(escapeCsvField("a,b")).toBe('"a,b"');
+  });
+  it("改行（LF・CR）を含む値は囲む", () => {
+    expect(escapeCsvField("a\nb")).toBe('"a\nb"');
+    expect(escapeCsvField("a\r\nb")).toBe('"a\r\nb"');
+  });
+  it('" は "" にして囲む', () => {
+    expect(escapeCsvField('say "hi"')).toBe('"say ""hi"""');
+  });
+});
+
+describe("monthCsvRows", () => {
+  it("出勤日は通常ルートで1行（往復・金額は片道 × 2）", () => {
+    expect(monthCsvRows([rec("2026-11-04", commute)])).toEqual([
+      ["2026-11-04", "水", "", "出勤", "通常", "自宅", "本社", "電車", "往復", "320", "640", "自宅↔本社", ""],
+    ]);
+  });
+
+  it("祝日名が入る", () => {
+    expect(monthCsvRows([rec("2026-11-03", commute)])[0]?.[2]).toBe("文化の日");
+  });
+
+  it("追加の移動は1件ごとに1行（ルート名は空、目的は入る）", () => {
+    const rows = monthCsvRows([rec("2026-11-04", commute, [trip({ purpose: "客先B打合せ" }), trip({ tripType: "roundTrip" })])]);
+    expect(rows).toHaveLength(3);
+    expect(rows[1]).toEqual(["2026-11-04", "水", "", "出勤", "追加", "本社", "客先B", "バス", "片道", "200", "200", "", "客先B打合せ"]);
+    expect(rows[2]?.slice(8, 11)).toEqual(["往復", "200", "400"]);
+  });
+
+  it("在宅・休日で追加の移動が無い日は行を作らない。追加の移動があれば作る", () => {
+    expect(monthCsvRows([rec("2026-11-05", { kind: "remote" }), rec("2026-11-07", { kind: "holiday" })])).toEqual([]);
+    const rows = monthCsvRows([rec("2026-11-05", { kind: "remote" }, [trip()])]);
+    expect(rows).toHaveLength(1);
+    expect(rows[0]?.slice(3, 5)).toEqual(["在宅", "追加"]);
+  });
+
+  it("日付順に並べ、渡した配列は変えない", () => {
+    const input = [rec("2026-11-10", commute), rec("2026-11-02", commute)];
+    expect(monthCsvRows(input).map((r) => r[0])).toEqual(["2026-11-02", "2026-11-10"]);
+    expect(input[0]?.date).toBe("2026-11-10");
+  });
+
+  it("列の数は見出しと同じ", () => {
+    for (const row of monthCsvRows([rec("2026-11-04", commute, [trip()])])) {
+      expect(row).toHaveLength(CSV_HEADER.length);
+    }
+  });
+
+  it("金額の列の和は monthlyFare の合計と合う", () => {
+    const records = [
+      rec("2026-11-02", commute, [trip(), trip({ tripType: "roundTrip", oneWayFare: 150 })]),
+      rec("2026-11-03", { kind: "remote" }, [trip({ oneWayFare: 90 })]),
+      rec("2026-11-04", commute),
+      rec("2026-11-05", { kind: "holiday" }),
+    ];
+    const amountIndex = CSV_HEADER.indexOf("金額");
+    const sum = monthCsvRows(records).reduce((acc, row) => acc + Number(row[amountIndex]), 0);
+    expect(sum).toBe(monthlyFare(records).total);
+    expect(monthCsvRows([])).toEqual([]);
+    expect(monthlyFare([]).total).toBe(0);
+  });
+});
+
+describe("monthCsv", () => {
+  it("BOM・見出し・CRLF で、最後の行にも改行が付く", () => {
+    const csv = monthCsv([rec("2026-11-04", commute)]);
+    expect(csv.startsWith(UTF8_BOM + CSV_HEADER.join(",") + "\r\n2026-11-04,水,,出勤,通常,")).toBe(true);
+    expect(csv.endsWith("\r\n")).toBe(true);
+    expect(csv.replaceAll("\r\n", "")).not.toMatch(/[\r\n]/);
+  });
+
+  it("記録が無い月は見出しだけ", () => {
+    expect(monthCsv([])).toBe(UTF8_BOM + CSV_HEADER.join(",") + "\r\n");
+  });
+
+  it("カンマ・改行・引用符を含む値はエスケープされ、読み戻すと元の値になる", () => {
+    const purpose = 'A社, "B"\n打合せ';
+    const csv = monthCsv([rec("2026-11-04", { kind: "remote" }, [trip({ purpose })])]);
+    expect(csv).toContain('"A社, ""B""\n打合せ"\r\n');
+  });
+});
+
+describe("csvFileName", () => {
+  it("routepense-YYYY-MM.csv", () => {
+    expect(csvFileName("2026-11")).toBe("routepense-2026-11.csv");
+  });
+});
