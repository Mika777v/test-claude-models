+import { describe, expect, it } from "vitest";
+import { CSV_HEADER, UTF8_BOM, csvFileName, escapeCsvField, monthCsv, monthCsvRows } from "./csv";
+import type { DailyRecord } from "./daily-record";
+import type { ExtraTrip } from "./extra-trip";
+import { monthlyFare } from "./fare";
+import type { WorkStyle } from "./work-style";
+
+const commute: WorkStyle = {
+  kind: "commute",
+  routeId: "route-1",
+  route: { name: "自宅↔本社", from: "自宅", to: "本社", transport: "train", oneWayFare: 320 },
+};
+
+function trip(overrides: Partial<ExtraTrip> = {}): ExtraTrip {
+  return {
+    id: "t1",
+    from: "本社",
+    to: "客先B",
+    transport: "bus",
+    oneWayFare: 200,
+    tripType: "oneWay",
+    ...overrides,
+  };
+}
+
+type Rec = Pick<DailyRecord, "date" | "workStyle" | "extraTrips">;
+function rec(date: string, workStyle: WorkStyle, extraTrips: ExtraTrip[] = []): Rec {
+  return { date, workStyle, extraTrips };
+}
+
+describe("escapeCsvField", () => {
+  it("普通の値はそのまま", () => {
+    expect(escapeCsvField("本社")).toBe("本社");
+    expect(escapeCsvField("")).toBe("");
+  });
+  it("カンマを含むと囲む", () => {
+    expect(escapeCsvField("A,B")).toBe('"A,B"');
+  });
+  it("改行（LF・CR）を含むと囲む", () => {
+    expect(escapeCsvField("a\nb")).toBe('"a\nb"');
+    expect(escapeCsvField("a\rb")).toBe('"a\rb"');
+  });
+  it('" は "" にして囲む', () => {
+    expect(escapeCsvField('say "hi"')).toBe('"say ""hi"""');
+    expect(escapeCsvField('"')).toBe('""""');
+  });
+});
+
+describe("monthCsvRows", () => {
+  it("出勤日の通常ルートは往復の1行（F7 の例）", () => {
+    expect(monthCsvRows([rec("2026-11-04", commute)])).toEqual([
+      ["2026-11-04", "水", "", "出勤", "通常", "自宅", "本社", "電車", "往復", "320", "640", "自宅↔本社", ""],
+    ]);
+  });
+
+  it("祝日名が入る。追加の移動は片道・ルート名が空・目的が入る", () => {
+    const rows = monthCsvRows([
+      rec("2026-11-03", { kind: "holiday" }, [trip({ purpose: "客先B打合せ" })]),
+    ]);
+    expect(rows).toEqual([
+      ["2026-11-03", "火", "文化の日", "休日", "追加", "本社", "客先B", "バス", "片道", "200", "200", "", "客先B打合せ"],
+    ]);
+  });
+
+  it("追加の移動の往復は金額が2倍", () => {
+    const [row] = monthCsvRows([rec("2026-11-05", { kind: "remote" }, [trip({ tripType: "roundTrip" })])]);
+    expect(row?.slice(4, 11)).toEqual(["追加", "本社", "客先B", "バス", "往復", "200", "400"]);
+  });
+
+  it("移動の無い日は行を作らない", () => {
+    expect(monthCsvRows([rec("2026-11-04", { kind: "remote" }), rec("2026-11-07", { kind: "holiday" })])).toEqual([]);
+  });
+
+  it("日付順に並べ、同じ日は通常 → 追加。引数は書き換えない", () => {
+    const records = [
+      rec("2026-11-06", commute, [trip({ id: "a" }), trip({ id: "b", to: "客先C" })]),
+      rec("2026-11-04", commute),
+    ];
+    const rows = monthCsvRows(records);
+    expect(rows.map((r) => [r[0], r[4], r[6]])).toEqual([
+      ["2026-11-04", "通常", "本社"],
+      ["2026-11-06", "通常", "本社"],
+      ["2026-11-06", "追加", "客先B"],
+      ["2026-11-06", "追加", "客先C"],
+    ]);
+    expect(records[0]?.date).toBe("2026-11-06");
+  });
+
+  it("列の数は見出しと同じ", () => {
+    for (const row of monthCsvRows([rec("2026-11-04", commute, [trip()])])) {
+      expect(row).toHaveLength(CSV_HEADER.length);
+    }
+  });
+
+  it("金額の列の和が monthlyFare の合計と合う", () => {
+    const records = [
+      rec("2026-11-02", commute, [trip({ tripType: "roundTrip" })]),
+      rec("2026-11-03", { kind: "holiday" }, [trip({ oneWayFare: 150 })]),
+      rec("2026-11-04", commute),
+      rec("2026-11-05", { kind: "remote" }),
+      rec("2026-11-06", { kind: "remote" }, [trip({ oneWayFare: 410 })]),
+    ];
+    const amountIndex = CSV_HEADER.indexOf("金額");
+    const sum = monthCsvRows(records).reduce((s, row) => s + Number(row[amountIndex]), 0);
+    expect(sum).toBe(monthlyFare(records).total);
+    expect(sum).toBe(640 + 400 + 150 + 640 + 410);
+  });
+});
+
+describe("monthCsv", () => {
+  it("BOM・見出し・CRLF・末尾の改行", () => {
+    const csv = monthCsv([rec("2026-11-04", commute)]);
+    expect(csv.startsWith(UTF8_BOM)).toBe(true);
+    expect(csv).toBe(
+      UTF8_BOM +
+        CSV_HEADER.join(",") + "\r\n" +
+        "2026-11-04,水,,出勤,通常,自宅,本社,電車,往復,320,640,自宅↔本社,\r\n",
+    );
+  });
+
+  it("明細が無くても見出しだけは出る", () => {
+    expect(monthCsv([])).toBe(UTF8_BOM + CSV_HEADER.join(",") + "\r\n");
+  });
+
+  it("カンマ・改行・引用符を含む値は囲まれ、行の数が壊れない", () => {
+    const csv = monthCsv([
+      rec("2026-11-04", { kind: "remote" }, [trip({ from: "A,B", purpose: '打合せ\n"急ぎ"' })]),
+    ]);
+    expect(csv).toContain('"A,B"');
+    expect(csv).toContain('"打合せ\n""急ぎ"""');
+  });
+});
+
+describe("csvFileName", () => {
+  it("routepense-YYYY-MM.csv", () => {
+    expect(csvFileName("2026-11")).toBe("routepense-2026-11.csv");
+  });
+});
