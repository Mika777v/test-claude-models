+
+/** アーカイブの切り替え（PATCH /api/routes/:id）の本文 */
+export type ArchiveInput = { archived: boolean };
+
+/** `{ "archived": true }` の形かを確かめる。archived は真偽値だけを受け付ける */
+export function parseArchiveInput(body: unknown): Result<ArchiveInput> {
+  if (!isRecord(body)) {
+    return { ok: false, errors: [{ field: "", message: "JSON のオブジェクトを送ってください" }] };
+  }
+  if (typeof body.archived !== "boolean") {
+    return { ok: false, errors: [{ field: "archived", message: "true か false で指定してください" }] };
+  }
+  return { ok: true, value: { archived: body.archived } };
+}
