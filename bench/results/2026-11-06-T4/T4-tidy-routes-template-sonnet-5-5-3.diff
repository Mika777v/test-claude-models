--- /dev/null
+++ b/frontend/src/routes/route-list.ts
@@ -0,0 +1,9 @@
+import type { Route } from "@routepense/shared";
+
+/** 使っているルートとアーカイブ済みのルートに分ける。それぞれ、元の並びを保つ */
+export function partitionRoutes(routes: readonly Route[]): { active: Route[]; archived: Route[] } {
+  return {
+    active: routes.filter((route) => !route.archived),
+    archived: routes.filter((route) => route.archived),
+  };
+}
