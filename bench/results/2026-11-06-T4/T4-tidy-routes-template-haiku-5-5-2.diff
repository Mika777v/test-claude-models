+import { describe, expect, it } from "vitest";
+import { parseArchivedInput } from "./parse-archived-input";
+
+describe("parseArchivedInput", () => {
+  it("true と false をそのまま受け付ける", () => {
+    expect(parseArchivedInput({ archived: true })).toEqual({ ok: true, value: true });
+    expect(parseArchivedInput({ archived: false })).toEqual({ ok: true, value: false });
+  });
+
+  it("boolean 以外（文字・数・無い項目）は、archived の欄の誤りにする", () => {
+    for (const body of [{ archived: "true" }, { archived: 0 }, { archived: null }, {}]) {
+      expect(parseArchivedInput(body)).toEqual({
+        ok: false,
+        errors: [{ field: "archived", message: "true か false を指定してください" }],
+      });
+    }
+  });
+
+  it("JSON のオブジェクトでない本文は、全体の誤りにする", () => {
+    for (const body of [null, "archived", [true], 1]) {
+      const result = parseArchivedInput(body);
+      expect(result.ok).toBe(false);
+    }
+  });
+});
