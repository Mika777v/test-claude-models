+import type { Route } from "@routepense/shared";
+import { describe, expect, it } from "vitest";
+import { splitRoutes } from "./route-list";
+
+const base = { userId: "u1", from: "中野", to: "東京", transport: "train", oneWayFare: 220 } as const;
+
+describe("splitRoutes", () => {
+  it("しまっていないルートと、しまったルートに分け、元の順を保つ", () => {
+    const a: Route = { ...base, id: "a", name: "自宅↔本社", archived: false };
+    const b: Route = { ...base, id: "b", name: "旧・自宅↔本社", archived: true };
+    const c: Route = { ...base, id: "c", name: "自宅↔客先A", archived: false };
+
+    expect(splitRoutes([a, b, c])).toEqual({ active: [a, c], archived: [b] });
+  });
+
+  it("ルートが無い・全部しまったときも、空の配列で返す", () => {
+    expect(splitRoutes([])).toEqual({ active: [], archived: [] });
+    const b: Route = { ...base, id: "b", name: "旧", archived: true };
+    expect(splitRoutes([b])).toEqual({ active: [], archived: [b] });
+  });
+});
