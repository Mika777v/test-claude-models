@@ -0,0 +1,11 @@
+import type { Route } from "@routepense/shared";
+
+/** 片付けていないルート。出勤の選択肢や、ルート管理画面の一覧に出すもの */
+export function activeRoutes(routes: Route[]): Route[] {
+  return routes.filter((route) => !route.archived);
+}
+
+/** 片付けたルート。ルート管理画面の「片付けたルート」に出す */
+export function archivedRoutes(routes: Route[]): Route[] {
+  return routes.filter((route) => route.archived === true);
+}
