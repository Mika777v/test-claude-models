     value: { name, from, to, transport: t, oneWayFare, ...(searchUrl !== undefined && { searchUrl }) },
   };
 }
+
+/**
+ * しまう・戻すの本文 { archived: boolean } を確かめる。
+ * 真偽値以外（"true" の文字列や、無い項目）は誤りにする。
+ */
+export function parseArchivedInput(body: unknown): Result<boolean> {
+  if (!isRecord(body) || typeof body.archived !== "boolean") {
+    return {
+      ok: false,
+      errors: [{ field: "archived", message: "archived に true か false を入れて送ってください" }],
+    };
+  }
+  return { ok: true, value: body.archived };
+}
