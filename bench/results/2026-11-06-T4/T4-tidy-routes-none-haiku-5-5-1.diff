@@ -0,0 +1,33 @@
+import type { Route } from "@routepense/shared";
+import { describe, expect, it } from "vitest";
+import { pickableRoutes, splitRoutes } from "./route-archive";
+
+function route(id: string, archived: boolean): Route {
+  return { id, userId: "u1", name: id, from: "A", to: "B", transport: "train", oneWayFare: 220, archived };
+}
+
+describe("splitRoutes", () => {
+  it("使っているルートとしまったルートに分け、どちらも元の並び順を保つ", () => {
+    const routes = [route("a", false), route("b", true), route("c", false), route("d", true)];
+    const { active, archived } = splitRoutes(routes);
+    expect(active.map((r) => r.id)).toEqual(["a", "c"]);
+    expect(archived.map((r) => r.id)).toEqual(["b", "d"]);
+  });
+
+  it("空の一覧は、両方とも空", () => {
+    expect(splitRoutes([])).toEqual({ active: [], archived: [] });
+  });
+});
+
+describe("pickableRoutes", () => {
+  it("しまったルートを選択肢から外す", () => {
+    const routes = [route("a", false), route("b", true)];
+    expect(pickableRoutes(routes).map((r) => r.id)).toEqual(["a"]);
+  });
+
+  it("元の配列は書き換えない", () => {
+    const routes = [route("a", false), route("b", true)];
+    pickableRoutes(routes);
+    expect(routes.map((r) => r.id)).toEqual(["a", "b"]);
+  });
+});
diff --git a/frontend/src/routes/route-archive.ts b/frontend/src/routes/route-archive.ts
new file mode 100644
index 0000000..c796a23
--- /dev/null
+++ b/frontend/src/routes/route-archive.ts
@@ -0,0 +1,22 @@
+import type { Route } from "@routepense/shared";
+
+/**
+ * ルートを「使っている」と「しまった」に分ける（純粋関数）。
+ * 一覧は使っているものを先に、しまったものを別に出す。
+ */
+export function splitRoutes(routes: readonly Route[]): { active: Route[]; archived: Route[] } {
+  const active: Route[] = [];
+  const archived: Route[] = [];
+  for (const route of routes) {
+    (route.archived ? archived : active).push(route);
+  }
+  return { active, archived };
+}
+
+/**
+ * 日の勤務区分・一括設定・追加の移動で選べるルート（しまったものを除く）。
+ * 過去の記録がしまったルートを使っていても、記録のコピーで表示されるので、ここでは外すだけでよい。
+ */
+export function pickableRoutes(routes: readonly Route[]): Route[] {
+  return routes.filter((route) => !route.archived);
+}
