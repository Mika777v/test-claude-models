@@ -0,0 +1,37 @@
+import type { Route } from "@routepense/shared";
+import { describe, expect, it } from "vitest";
+import { selectableRoutes, splitRoutesByArchive } from "./route-archive";
+
+function route(id: string, archived: boolean): Route {
+  return { id, userId: "u", name: `R${id}`, from: "A", to: "B", transport: "train", oneWayFare: 220, archived };
+}
+
+const routes = [route("a", false), route("b", true), route("c", false)];
+
+describe("selectableRoutes", () => {
+  it("しまったルートは外し、残りは元の順番のまま", () => {
+    expect(selectableRoutes(routes).map((r) => r.id)).toEqual(["a", "c"]);
+  });
+
+  it("keepRouteId で渡したしまったルートは残す", () => {
+    expect(selectableRoutes(routes, "b").map((r) => r.id)).toEqual(["a", "b", "c"]);
+  });
+
+  it("ルートが無ければ空", () => {
+    expect(selectableRoutes([])).toEqual([]);
+  });
+});
+
+describe("splitRoutesByArchive", () => {
+  it("使っているものとしまったものに分ける", () => {
+    const { active, archived } = splitRoutesByArchive(routes);
+    expect(active.map((r) => r.id)).toEqual(["a", "c"]);
+    expect(archived.map((r) => r.id)).toEqual(["b"]);
+  });
+
+  it("全部しまったときは、使っているものが空", () => {
+    const { active, archived } = splitRoutesByArchive([route("x", true)]);
+    expect(active).toEqual([]);
+    expect(archived).toHaveLength(1);
+  });
+});
diff --git a/frontend/src/routes/route-archive.ts b/frontend/src/routes/route-archive.ts
new file mode 100644
index 0000000..5c55fe7
--- /dev/null
+++ b/frontend/src/routes/route-archive.ts
@@ -0,0 +1,18 @@
+import type { Route } from "@routepense/shared";
+
+/**
+ * 出勤・追加の移動・一括設定で選べるルート（しまったルートを外す）。
+ * keepRouteId を渡すと、そのルートだけは、しまってあっても残す。
+ * 例: 追加の移動を直すとき、元のルートがしまってあっても、欄の選択が空に見えないようにする。
+ */
+export function selectableRoutes(routes: readonly Route[], keepRouteId?: string): Route[] {
+  return routes.filter((route) => !route.archived || route.id === keepRouteId);
+}
+
+/** ルートの管理画面で、使っているものとしまったものに分ける。どちらも元の並び順のまま */
+export function splitRoutesByArchive(routes: readonly Route[]): { active: Route[]; archived: Route[] } {
+  return {
+    active: routes.filter((route) => !route.archived),
+    archived: routes.filter((route) => route.archived),
+  };
+}
