--- a/backend/src/routes/route-router.ts
+++ b/backend/src/routes/route-router.ts
@@ -21,6 +21,15 @@ export function routeRouter(repo: RouteRepository, userId: string): Router {
       res.status(400).json(body);
       return;
     }
+    // 出勤を選ぶときに見分けられなくなるので、同じ名前のルートは登録させない
+    if (repo.list(userId).some((r) => r.name === parsed.value.name)) {
+      const body: ApiError = {
+        error: "入力に誤りがあります",
+        fieldErrors: [{ field: "name", message: "同じ名前のルートがあります" }],
+      };
+      res.status(409).json(body);
+      return;
+    }
     res.status(201).json(repo.create(userId, parsed.value));
