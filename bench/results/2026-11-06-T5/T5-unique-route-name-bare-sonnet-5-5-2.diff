+  });
+
+  it("違う名前なら続けて登録できる", async () => {
+    await send("POST", "", input);
+    const res = await send("POST", "", { ...input, name: "自宅↔支社" });
+    expect(res.status).toBe(201);
+    const list = (await (await send("GET", "")).json()) as Route[];
+    expect(list).toHaveLength(2);
+  });
