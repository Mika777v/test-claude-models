+    version: 4,
+    sql: `
+      -- 交通手段に taxi を足す。SQLite は CHECK を後から変えられないので、3つのテーブルを作り直してデータを移す
+      CREATE TABLE routes_new (
+        id           TEXT PRIMARY KEY,
+        user_id      TEXT NOT NULL,
+        name         TEXT NOT NULL,
+        from_place   TEXT NOT NULL,
+        to_place     TEXT NOT NULL,
+        transport    TEXT NOT NULL CHECK (transport IN ('train', 'bus', 'taxi', 'other')),
+        one_way_fare INTEGER NOT NULL CHECK (one_way_fare >= 0),
+        created_at   TEXT NOT NULL,
+        updated_at   TEXT NOT NULL,
+        search_url   TEXT
+      );
+      INSERT INTO routes_new (id, user_id, name, from_place, to_place, transport, one_way_fare, created_at, updated_at, search_url)
+        SELECT id, user_id, name, from_place, to_place, transport, one_way_fare, created_at, updated_at, search_url FROM routes;
+      DROP TABLE routes;
+      ALTER TABLE routes_new RENAME TO routes;
+      CREATE INDEX routes_user_id ON routes (user_id);
+
+      CREATE TABLE daily_records_new (
+        id           TEXT PRIMARY KEY,
+        user_id      TEXT NOT NULL,
+        date         TEXT NOT NULL,
+        work_kind    TEXT NOT NULL CHECK (work_kind IN ('remote', 'commute', 'holiday')),
+        route_id           TEXT,
+        route_name         TEXT,
+        route_from         TEXT,
+        route_to           TEXT,
+        route_transport    TEXT CHECK (route_transport IN ('train', 'bus', 'taxi', 'other')),
+        route_one_way_fare INTEGER CHECK (route_one_way_fare >= 0),
+        created_at   TEXT NOT NULL,
+        updated_at   TEXT NOT NULL,
+        UNIQUE (user_id, date),
+        CHECK (
+          (work_kind = 'commute' AND route_id IS NOT NULL AND route_name IS NOT NULL
+            AND route_from IS NOT NULL AND route_to IS NOT NULL
+            AND route_transport IS NOT NULL AND route_one_way_fare IS NOT NULL)
+          OR
+          (work_kind <> 'commute' AND route_id IS NULL AND route_name IS NULL
+            AND route_from IS NULL AND route_to IS NULL
+            AND route_transport IS NULL AND route_one_way_fare IS NULL)
+        )
+      );
+      INSERT INTO daily_records_new SELECT id, user_id, date, work_kind, route_id, route_name, route_from, route_to,
+        route_transport, route_one_way_fare, created_at, updated_at FROM daily_records;
+
+      CREATE TABLE extra_trips_new (
+        id              TEXT PRIMARY KEY,
+        daily_record_id TEXT NOT NULL REFERENCES daily_records (id) ON DELETE CASCADE,
+        from_place      TEXT NOT NULL,
+        to_place        TEXT NOT NULL,
+        transport       TEXT NOT NULL CHECK (transport IN ('train', 'bus', 'taxi', 'other')),
+        one_way_fare    INTEGER NOT NULL CHECK (one_way_fare >= 0),
+        trip_type       TEXT NOT NULL CHECK (trip_type IN ('oneWay', 'roundTrip')),
+        purpose         TEXT,
+        source_route_id TEXT,
+        created_at      TEXT NOT NULL
+      );
+      INSERT INTO extra_trips_new SELECT id, daily_record_id, from_place, to_place, transport, one_way_fare, trip_type,
+        purpose, source_route_id, created_at FROM extra_trips;
+
+      DROP TABLE extra_trips;
+      DROP TABLE daily_records;
+      ALTER TABLE daily_records_new RENAME TO daily_records;
+      ALTER TABLE extra_trips_new RENAME TO extra_trips;
+      CREATE INDEX extra_trips_daily_record_id ON extra_trips (daily_record_id);
+    `,
+  },
 ];
