@@ -0,0 +1,26 @@
+import { MAX_NOTE, type DailyRecord } from "@routepense/shared";
+
+/**
+ * 日のメモの欄で使う純粋関数。
+ * backend と同じく、前後の空白を除いた文字数で長さを数える（空白だけなら「メモなし」）。
+ */
+
+/** 保存するときの値（前後の空白を除いたもの） */
+export function normalizeNote(value: string): string {
+  return value.trim();
+}
+
+/** 欄の値が、保存済みのメモと違うか（前後の空白だけの違いは同じとみなす） */
+export function isNoteChanged(value: string, record: Pick<DailyRecord, "note">): boolean {
+  return normalizeNote(value) !== (record.note ?? "");
+}
+
+/** 長さの誤りの文。誤りが無ければ null */
+export function noteLengthError(value: string): string | null {
+  return normalizeNote(value).length > MAX_NOTE ? `メモは${MAX_NOTE}文字以内で入力してください` : null;
+}
+
+/** 欄の下に出す文字数（例: 12 / 200） */
+export function noteCount(value: string): string {
+  return `${normalizeNote(value).length} / ${MAX_NOTE}`;
+}
