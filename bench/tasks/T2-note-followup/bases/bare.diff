+++ b/frontend/src/calendar/DayNote.tsx
@@ -0,0 +1,82 @@
+import type { DailyRecord } from "@routepense/shared";
+import { useState, type FormEvent } from "react";
+import { saveDailyRecordNote } from "./daily-records-api";
+import { errorMessage } from "./day-edit";
+import { isNoteChanged, normalizeNote, noteCount, noteLengthError } from "./day-note";
+
+type Props = {
+  /** その日の記録（メモは、記録のある日にだけ付けられる） */
+  record: DailyRecord;
+  /** メモを保存した後の記録。親が一覧を置き換える */
+  onChange: (record: DailyRecord) => void;
+};
+
+/**
+ * 日の編集パネルの中の「メモ」。勤務区分と違い、書きかけで保存されないよう「保存」ボタンで保存する。
+ * 空にして保存すると、メモを消す。
+ */
+export function DayNote({ record, onChange }: Props) {
+  const [value, setValue] = useState(record.note ?? "");
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [saved, setSaved] = useState<string | null>(null);
+
+  const lengthError = noteLengthError(value);
+  const changed = isNoteChanged(value, record);
+
+  async function handleSubmit(e: FormEvent) {
+    e.preventDefault();
+    if (saving || !changed || lengthError) return;
+    setSaving(true);
+    setError(null);
+    setSaved(null);
+    const result = await saveDailyRecordNote(record.date, value);
+    setSaving(false);
+    if (!result.ok) {
+      setError(errorMessage(result.error));
+      return;
+    }
+    // 保存した値（前後の空白を除いたもの）に、欄をそろえる
+    setValue(result.value.note ?? "");
+    setSaved(result.value.note === undefined ? "メモを消しました" : "メモを保存しました");
+    onChange(result.value);
+  }
+
+  const invalid = lengthError !== null;
+
+  return (
+    <form className="day-note" aria-labelledby="day-note-heading" onSubmit={(e) => void handleSubmit(e)}>
+      <h4 id="day-note-heading">
+        <label htmlFor="day-note-input">メモ</label>
+      </h4>
+      <textarea
+        id="day-note-input"
+        rows={2}
+        value={value}
+        placeholder="健康診断で直帰"
+        onChange={(e) => {
+          setValue(e.target.value);
+          setSaved(null);
+        }}
+        aria-invalid={invalid || undefined}
+        aria-describedby="day-note-count"
+      />
+      <p id="day-note-count" className={invalid ? "day-note-count field-error" : "day-note-count"}>
+        {lengthError ?? noteCount(value)}
+      </p>
+      <div className="day-note-actions">
+        <button type="submit" disabled={saving || !changed || invalid}>
+          {saving ? "保存しています…" : normalizeNote(value) === "" && record.note !== undefined ? "メモを消す" : "メモを保存"}
+        </button>
+        <span className="muted" role="status">
+          {saved}
+        </span>
+      </div>
+      {error && (
+        <p className="form-alert" role="alert">
+          {error}
+        </p>
+      )}
+    </form>
+  );
+}
