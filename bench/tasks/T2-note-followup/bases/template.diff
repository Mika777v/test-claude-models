+import { NOTE_MAX_LENGTH } from "@routepense/shared";
+import { describe, expect, it } from "vitest";
+import { isNoteChanged, noteError, noteLength } from "./note-form";
+
+describe("note-form", () => {
+  it("文字数は前後の空白を除いて数える", () => {
+    expect(noteLength("  健康診断で直帰 \n")).toBe(7);
+  });
+
+  it("前後の空白を除いて上限までは誤りなし。1文字でも超えると文を返す", () => {
+    expect(noteError(` ${"あ".repeat(NOTE_MAX_LENGTH)} `)).toBeNull();
+    expect(noteError("あ".repeat(NOTE_MAX_LENGTH + 1))).toBe("メモは200文字以内で入力してください");
+  });
+
+  it("前後の空白だけの違いは、変わっていないとみなす。メモが無い日は空と同じ", () => {
+    expect(isNoteChanged(" 直帰 ", "直帰")).toBe(false);
+    expect(isNoteChanged("  ", undefined)).toBe(false);
+    expect(isNoteChanged("直帰", undefined)).toBe(true);
+    expect(isNoteChanged("", "直帰")).toBe(true);
+  });
+});
diff --git a/frontend/src/calendar/note-form.ts b/frontend/src/calendar/note-form.ts
new file mode 100644
index 0000000..3cd9d07
--- /dev/null
+++ b/frontend/src/calendar/note-form.ts
@@ -0,0 +1,22 @@
+import { NOTE_MAX_LENGTH } from "@routepense/shared";
+
+/**
+ * 日のメモの欄の、画面側の確かめ（純粋関数）。
+ * 本当の確かめは API の受け口（backend）で行う。ここでは、送る前に分かる誤りを先に見せるだけ。
+ * 数え方は backend と同じ（前後の空白を除いた文字数）。
+ */
+
+/** 保存するときに数える文字数（前後の空白を除く） */
+export function noteLength(text: string): number {
+  return text.trim().length;
+}
+
+/** 長すぎるときの文。問題が無ければ null */
+export function noteError(text: string): string | null {
+  return noteLength(text) > NOTE_MAX_LENGTH ? `メモは${NOTE_MAX_LENGTH}文字以内で入力してください` : null;
+}
+
+/** 保存済みのメモ（無ければ undefined）から変わったか。前後の空白だけの違いは、変わっていないとみなす */
+export function isNoteChanged(text: string, saved: string | undefined): boolean {
+  return text.trim() !== (saved ?? "");
+}
