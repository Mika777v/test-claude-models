+++ b/frontend/src/calendar/DayNote.tsx
@@ -0,0 +1,70 @@
+import { NOTE_MAX_LENGTH, type DailyRecord } from "@routepense/shared";
+import { useState } from "react";
+import { saveDailyRecordNote } from "./daily-records-api";
+import { errorMessage } from "./day-edit";
+import { isNoteChanged, noteError, noteLength } from "./note-form";
+
+type Props = {
+  /** その日の記録（メモは、記録のある日にだけ付けられる） */
+  record: DailyRecord;
+  /** メモを保存できた後の記録。親が一覧を置き換える */
+  onSaved: (record: DailyRecord) => void;
+};
+
+/**
+ * 日の編集パネルの中の「メモ」。勤務区分と違い、打ち終えてから「メモを保存」で保存する
+ * （1文字ごとに保存すると、打っている途中の文が残るため）。空にして保存するとメモを消す。
+ */
+export function DayNote({ record, onSaved }: Props) {
+  const [text, setText] = useState(record.note ?? "");
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const invalid = noteError(text);
+  const changed = isNoteChanged(text, record.note);
+
+  async function save() {
+    if (saving || invalid !== null || !changed) return;
+    setSaving(true);
+    setError(null);
+    const result = await saveDailyRecordNote(record.date, text);
+    if (result.ok) {
+      setText(result.value.note ?? "");
+      onSaved(result.value);
+    } else {
+      setError(errorMessage(result.error));
+    }
+    setSaving(false);
+  }
+
+  return (
+    <section className="day-note" aria-labelledby="day-note-heading">
+      <h4 id="day-note-heading">メモ</h4>
+      <div className="field">
+        <label htmlFor="day-note-text" className="sr-only">
+          この日のメモ（任意）
+        </label>
+        <textarea
+          id="day-note-text"
+          rows={2}
+          value={text}
+          placeholder="健康診断で直帰"
+          onChange={(e) => setText(e.target.value)}
+          aria-invalid={invalid !== null}
+          aria-describedby="day-note-count"
+        />
+        <p id="day-note-count" className={invalid ? "field-error" : "muted day-note-count"}>
+          {invalid ?? `${noteLength(text)} / ${NOTE_MAX_LENGTH}文字。空にして保存すると消えます`}
+        </p>
+      </div>
+      <button type="button" disabled={saving || invalid !== null || !changed} onClick={() => void save()}>
+        {saving ? "保存しています…" : "メモを保存"}
+      </button>
+      {error && (
+        <p className="form-alert" role="alert">
+          {error}
+        </p>
+      )}
+    </section>
+  );
+}
