 import type { Result } from "../validation/result";
@@ -45,6 +46,28 @@ export function parseDailyRecordInput(body: unknown): Result<WorkStyleInput> {
   return parseWorkStyleInput(body.workStyle);
 }
 
+/**
+ * PUT /api/daily-records/:date/note の本文 { note } を確かめる。
+ * 前後の空白を除いて NOTE_MAX_LENGTH 文字まで。空（空白だけを含む）なら undefined（メモを消す）
+ */
+export function parseNoteInput(body: unknown): Result<string | undefined> {
+  if (!isRecord(body)) {
+    return { ok: false, errors: notObject };
+  }
+  const note = body.note;
+  if (typeof note !== "string") {
+    return { ok: false, errors: [{ field: "note", message: "メモは文字で入力してください" }] };
+  }
+  const trimmed = note.trim();
+  if (trimmed.length > NOTE_MAX_LENGTH) {
+    return {
+      ok: false,
+      errors: [{ field: "note", message: `メモは${NOTE_MAX_LENGTH}文字以内で入力してください` }],
+    };
+  }
+  return { ok: true, value: trimmed === "" ? undefined : trimmed };
+}
+
 function isTripType(value: unknown): value is TripType {
   return value === "oneWay" || value === "roundTrip";
 }
