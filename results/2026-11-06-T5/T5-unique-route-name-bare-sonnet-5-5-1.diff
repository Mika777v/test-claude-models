+import { describe, expect, it } from "vitest";
+import { toRouteFormErrors } from "./route-form";
+
+describe("名前の重複のエラー", () => {
+  it("ルート名の欄のエラーになる", () => {
+    const { byField, other } = toRouteFormErrors([{ field: "name", message: "同じ名前のルートがあります" }]);
+    expect(byField.name).toBe("同じ名前のルートがあります");
+    expect(other).toEqual([]);
+  });
+});
