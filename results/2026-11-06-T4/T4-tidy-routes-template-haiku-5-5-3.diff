@@ -0,0 +1,20 @@
+import type { Route } from "@routepense/shared";
+
+/**
+ * 使っているルートと、しまっているルートに分ける（ルートの画面で、2つのまとまりとして出す）。
+ * 並びは受け取った順のまま（API は登録した順で返す）。
+ */
+export function splitRoutes(routes: readonly Route[]): { active: Route[]; archived: Route[] } {
+  return {
+    active: routes.filter((route) => !route.archived),
+    archived: routes.filter((route) => route.archived),
+  };
+}
+
+/**
+ * 出勤・追加の移動の選択肢に出すルート（しまっていないもの）。
+ * しまったルートは選べない。すでに記録にあるルートは、記録のコピーの名前で今の選択として出る（DayPanel）。
+ */
+export function choosableRoutes(routes: readonly Route[]): Route[] {
+  return splitRoutes(routes).active;
+}
