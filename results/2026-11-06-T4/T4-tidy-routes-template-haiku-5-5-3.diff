+import type { Route } from "@routepense/shared";
+import { describe, expect, it } from "vitest";
+import { choosableRoutes, splitRoutes } from "./route-archive";
+
+const base = { userId: "u1", from: "A駅", to: "B駅", transport: "train", oneWayFare: 220 } as const;
+const active: Route = { ...base, id: "r1", name: "自宅↔本社" };
+const archived: Route = { ...base, id: "r2", name: "旧本社", archived: true };
+const another: Route = { ...base, id: "r3", name: "客先A" };
+
+describe("splitRoutes", () => {
+  it("使っているルートとしまっているルートに分け、並びは保つ", () => {
+    expect(splitRoutes([active, archived, another])).toEqual({ active: [active, another], archived: [archived] });
+  });
+
+  it("しまったルートが無ければ archived は空", () => {
+    expect(splitRoutes([active])).toEqual({ active: [active], archived: [] });
+  });
+});
+
+describe("choosableRoutes", () => {
+  it("しまったルートは選択肢に出さない", () => {
+    expect(choosableRoutes([archived, active])).toEqual([active]);
+  });
+
+  it("全部しまっていれば選択肢は空（一括設定は「出勤」を選べない）", () => {
+    expect(choosableRoutes([archived])).toEqual([]);
+  });
+});
