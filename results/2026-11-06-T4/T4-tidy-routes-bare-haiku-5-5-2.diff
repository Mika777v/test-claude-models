@@ -0,0 +1,33 @@
+import type { Route } from "@routepense/shared";
+import { describe, expect, it } from "vitest";
+import { splitByArchived, usableRoutes } from "./route-archive";
+
+function route(id: string, archived: boolean): Route {
+  return { id, userId: "u1", name: id, from: "中野", to: "東京", transport: "train", oneWayFare: 220, archived };
+}
+
+describe("usableRoutes", () => {
+  it("アーカイブしていないルートだけを、登録した順のまま返す", () => {
+    const routes = [route("a", false), route("b", true), route("c", false)];
+    expect(usableRoutes(routes).map((r) => r.id)).toEqual(["a", "c"]);
+  });
+
+  it("全部アーカイブなら空の配列", () => {
+    expect(usableRoutes([route("a", true)])).toEqual([]);
+  });
+});
+
+describe("splitByArchived", () => {
+  it("使うルートとアーカイブ済みを分け、それぞれ登録した順を保つ", () => {
+    const routes = [route("a", false), route("b", true), route("c", false), route("d", true)];
+    const { usable, archived } = splitByArchived(routes);
+    expect(usable.map((r) => r.id)).toEqual(["a", "c"]);
+    expect(archived.map((r) => r.id)).toEqual(["b", "d"]);
+  });
+
+  it("元の一覧は書き換えない", () => {
+    const routes = [route("a", true)];
+    splitByArchived(routes);
+    expect(routes.map((r) => r.id)).toEqual(["a"]);
+  });
+});
diff --git a/frontend/src/routes/route-archive.ts b/frontend/src/routes/route-archive.ts
new file mode 100644
index 0000000..b169e9c
--- /dev/null
+++ b/frontend/src/routes/route-archive.ts
@@ -0,0 +1,19 @@
+import type { Route } from "@routepense/shared";
+
+/**
+ * 出勤・追加の移動・一括設定で選べるルート（アーカイブしていないもの）。
+ * 一覧の並び（登録した順）は保つ。
+ */
+export function usableRoutes(routes: readonly Route[]): Route[] {
+  return routes.filter((route) => !route.archived);
+}
+
+/**
+ * ルートの管理画面に出すために、使うルートとアーカイブ済みのルートに分ける（どちらも登録した順）。
+ */
+export function splitByArchived(routes: readonly Route[]): { usable: Route[]; archived: Route[] } {
+  return {
+    usable: usableRoutes(routes),
+    archived: routes.filter((route) => route.archived),
+  };
+}
