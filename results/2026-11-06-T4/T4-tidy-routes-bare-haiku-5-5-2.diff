+import { describe, expect, it } from "vitest";
+import { parseArchivedInput } from "./parse-archived-input";
+
+describe("parseArchivedInput", () => {
+  it("true / false を受け取る", () => {
+    expect(parseArchivedInput({ archived: true })).toEqual({ ok: true, value: true });
+    expect(parseArchivedInput({ archived: false })).toEqual({ ok: true, value: false });
+  });
+
+  it("真偽値でなければエラー（文字列の \"true\" や数値の 1 は受け取らない）", () => {
+    for (const archived of ["true", 1, 0, null, undefined]) {
+      const result = parseArchivedInput({ archived });
+      expect(result.ok).toBe(false);
+      if (!result.ok) expect(result.errors.map((e) => e.field)).toEqual(["archived"]);
+    }
+  });
+
+  it("オブジェクトでなければエラー", () => {
+    for (const body of [null, [true], "text", undefined]) {
+      const result = parseArchivedInput(body);
+      expect(result.ok).toBe(false);
+      if (!result.ok) expect(result.errors.map((e) => e.field)).toEqual([""]);
+    }
+  });
+});
diff --git a/backend/src/routes/parse-archived-input.ts b/backend/src/routes/parse-archived-input.ts
new file mode 100644
index 0000000..05b458e
--- /dev/null
+++ b/backend/src/routes/parse-archived-input.ts
@@ -0,0 +1,19 @@
+import type { FieldError } from "@routepense/shared";
+import { isRecord } from "../validation/fields";
+import type { Result } from "../validation/result";
+
+/**
+ * PUT /api/routes/:id/archived の本文 `{ "archived": true | false }` を確かめる。
+ * 型は実行するときに消えるので、外から来た値は、ここで1つずつ確かめる（parse-route-input.ts と同じ考え方）。
+ */
+export function parseArchivedInput(body: unknown): Result<boolean> {
+  if (!isRecord(body)) {
+    return { ok: false, errors: [{ field: "", message: "JSON のオブジェクトを送ってください" }] };
+  }
+  const value = body.archived;
+  if (typeof value !== "boolean") {
+    const errors: FieldError[] = [{ field: "archived", message: "archived は true か false で送ってください" }];
+    return { ok: false, errors };
+  }
+  return { ok: true, value };
+}
