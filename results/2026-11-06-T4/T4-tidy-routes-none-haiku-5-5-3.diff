+
+/**
+ * 「使わなくする・戻す」の本文 `{ "archived": true | false }` を確かめる。
+ * 値は boolean だけを受け付け、"true" のような文字列は通さない。
+ */
+export function parseArchivedInput(body: unknown): Result<boolean> {
+  if (!isRecord(body) || typeof body.archived !== "boolean") {
+    return {
+      ok: false,
+      errors: [{ field: "archived", message: "使わなくするかどうかを true か false で指定してください" }],
+    };
+  }
+  return { ok: true, value: body.archived };
+}
