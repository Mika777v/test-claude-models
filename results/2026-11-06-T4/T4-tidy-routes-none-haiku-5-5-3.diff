+ * ルートを登録・編集するときに送る値（id と userId はサーバーが決める）。
+ * archived は「使わなくする・戻す」の操作で切り替えるので、ここには含めない
+ */
+export type RouteInput = Omit<Route, "id" | "userId" | "archived">;
+
+/** 出勤などで選べるルートだけを取り出す（使わなくなったルートを除く）。選択肢はこれを通して作る */
+export function activeRoutes(routes: readonly Route[]): Route[] {
+  return routes.filter((route) => !route.archived);
+}
