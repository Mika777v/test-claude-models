+import { describe, expect, it } from "vitest";
+import { activeRoutes, type Route } from "./route";
+
+const base: Route = {
+  id: "r1",
+  userId: "user-1",
+  name: "自宅↔本社",
+  from: "A駅",
+  to: "B駅",
+  transport: "train",
+  oneWayFare: 220,
+  archived: false,
+};
+
+describe("activeRoutes", () => {
+  it("使わなくなったルートを除き、残りは登録した順のまま", () => {
+    const routes: Route[] = [
+      { ...base, id: "a" },
+      { ...base, id: "b", archived: true },
+      { ...base, id: "c" },
+    ];
+
+    expect(activeRoutes(routes).map((r) => r.id)).toEqual(["a", "c"]);
+  });
+
+  it("すべて使わなくなっていれば空、一覧が空なら空", () => {
+    expect(activeRoutes([{ ...base, archived: true }])).toEqual([]);
+    expect(activeRoutes([])).toEqual([]);
+  });
+
+  it("元の配列は変えない", () => {
+    const routes: Route[] = [{ ...base, archived: true }, base];
+    activeRoutes(routes);
+
+    expect(routes).toHaveLength(2);
+  });
+});
